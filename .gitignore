# Dependencies
node_modules/
.pnpm-store/

# Turborepo
.turbo/

# Build output
.next/
build/
dist/
out/
coverage/

# Environment files
.env
.env.*
!.env.example

# Debug logs
*.log

# Editors and operating systems
.DS_Store
.idea/
*.swp

# TypeScript
*.tsbuildinfo

# Scriptc intermediate compiler output
.scriptc/

# Standalone executables
dist-bin/

# Rebuilt vendored source and inrepo caches
inrepo_modules/
.inrepo/

# Native distribution archives
artifacts/

# Native files staged for release. Manifests and changelogs stay in git.
npm/*/*
!npm/*/package.json
!npm/*/CHANGELOG.md

# Browser test artifacts
playwright-report/
test-results/

# Leadtype package output. Authored pages live in docs/cli.
/packages/cli/AGENTS.md
/packages/cli/SKILL.md
/packages/cli/docs/cli/

# SDK: framework and tool output
.nuxt/
.output/
.svelte-kit/
internals/fixtures/astro-demo/.astro/
packages/sdk/astro/test/fixtures/**/.astro/
# Nuxt links its build output here
benchmarks/tailwind-matrix/*/nuxt/dist
.vercel/
.wrangler/
.build/
/.swiftpm/
dist-types/
storybook-static/
debug-storybook.log
.merge_file_*
coverage.json
i18n.cache
.test-apps/
.benchmarks/
.inth-state.json
apps/bundle-bench-react/.bundle-bench-dist/
live-vendors-report.json
__pycache__/
*.pyc
*.pem
.dev.vars
.*.vars

# SDK: `genversion` output. These paths only, so the hand-written
# packages/react-native/src/protocol/protocol-version.model.ts stays tracked.
**/src/version.ts
**/src/lib/version.ts

# SDK: generated package documentation and agent indexes
packages/sdk/*/docs/
packages/sdk/*/AGENTS.md
packages/sdk/*/SKILL.md
packages/sdk/*/skills/
packages/react-native/docs/
packages/react-native/AGENTS.md
packages/react-native/SKILL.md
packages/react-native/skills/

# SDK: each example's `.env` holds only the public demo backend URL, so the
# example runs as checked out. Never add secrets to these files.
!/examples/astro/.env
!/examples/astro-static/.env
!/examples/javascript/.env
!/examples/nextjs/.env
!/examples/nextjs-pages-router/.env
!/examples/nuxt/.env
!/examples/nuxt-static/.env
!/examples/react/.env
!/examples/shopify-nextjs/.env
!/examples/showcase-nuxt-theme/.env
!/examples/svelte/.env
!/examples/sveltekit/.env
!/examples/tanstack-start/.env
!/examples/vue/.env
!/internals/svelte-compat/*/.env
!.env.*.example

# Vitest browser-mode failure output
__screenshots__/
.vitest-attachments/

# Scratch copies from packages/cli/scripts/scaffold-build-checks.ts.
/examples/.scaffold-check-*/

# Rsdoctor reports (WITH_RSDOCTOR=1 builds)
.rsdoctor/
.vitest/
