{
  "name": "@inth/fixture-acceptance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "fmt": "oxfmt -c ../../../oxfmt.sdk.config.ts .",
    "lint": "oxlint -c ../../../oxlint.sdk.config.ts src",
    "test": "vitest run",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "test:starters": "vitest run --config vitest.starters.config.ts"
  },
  "devDependencies": {
    "@inth/nextjs": "workspace:*",
    "@inth/sdk": "workspace:*",
    "@types/node": "25.5.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "jsdom": "25.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "playwright": "1.61.1",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
