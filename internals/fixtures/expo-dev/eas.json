{
	"cli": {
		"version": ">=18.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development",
			"env": {
				"EXPO_PUBLIC_INTH_FAKE_NATIVE": "false",
				"INTH_LOCAL_PODS": "false"
			},
			"android": { "buildType": "apk" }
		},
		"preview": {
			"developmentClient": false,
			"distribution": "internal",
			"environment": "preview",
			"env": {
				"EXPO_PUBLIC_INTH_FAKE_NATIVE": "false",
				"INTH_LOCAL_PODS": "false"
			},
			"android": { "buildType": "apk" }
		}
	}
}
