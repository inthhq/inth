{
	"name": "@inth/fixture-react-native-bare",
	"version": "0.0.0",
	"private": true,
	"description": "Bare React Native fixture for @inth/react-native: native consent kernel, built-in banner and dialog, preference centre, consent-gated loading, and a fake native stub for offline gating checks.",
	"main": "index.js",
	"scripts": {
		"android": "react-native run-android",
		"bundle": "pnpm run bundle:android && pnpm run bundle:ios",
		"bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output .artifacts/android/index.android.bundle --assets-dest .artifacts/android",
		"bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output .artifacts/ios/main.jsbundle --assets-dest .artifacts/ios",
		"check-types": "tsrs --noEmit",
		"e2e:android": "bash scripts/app-e2e.sh android",
		"e2e:ios": "bash scripts/app-e2e.sh ios",
		"fmt": "vp fmt -c ../../../oxfmt.sdk.config.ts .",
		"ios": "react-native run-ios",
		"lint": "vp lint -c ../../../oxlint.sdk.config.ts App.tsx index.js src",
		"pod-install": "pod install --project-directory=ios",
		"start": "react-native start",
		"start:reset": "react-native start --reset-cache",
		"test": "vp test run"
	},
	"dependencies": {
		"@amplitude/analytics-react-native": "1.13.0",
		"@inth/react-native": "workspace:*",
		"@inth/sdk": "workspace:*",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-firebase/analytics": "27.1.0",
		"@react-native-firebase/app": "27.1.0",
		"@sentry/react-native": "8.33.0",
		"mixpanel-react-native": "4.0.0",
		"posthog-react-native": "4.85.1",
		"react": "19.2.7",
		"react-native": "0.87.1",
		"react-native-get-random-values": "1.11.0"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@babel/preset-env": "^7.25.3",
		"@babel/runtime": "^7.25.0",
		"@react-native-community/cli": "20.2.0",
		"@react-native-community/cli-platform-android": "20.2.0",
		"@react-native-community/cli-platform-ios": "20.2.0",
		"@react-native/babel-preset": "0.87.1",
		"@react-native/codegen": "0.87.1",
		"@react-native/gradle-plugin": "0.87.1",
		"@react-native/metro-config": "0.87.1",
		"@react-native/typescript-config": "0.87.1",
		"@testing-library/react-native": "14.1.0",
		"@types/node": "25.5.0",
		"@types/react": "~19.2.2",
		"@vitest/coverage-istanbul": "catalog:",
		"hermes-compiler": "250829098.0.17",
		"jsdom": "25.0.1",
		"test-renderer": "1.2.0",
		"tsrs": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">= 22.11.0"
	}
}
