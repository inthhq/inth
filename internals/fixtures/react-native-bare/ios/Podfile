# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# c15t's core needs iOS 16.4, which is above the floor React Native 0.87 installs.
# Declaring the lower version here makes CocoaPods reject the pod rather than warn.
platform :ios, '16.4'
prepare_react_native_project!

# React Native Firebase resolves the Firebase SDK through Swift Package Manager and
# rejects static pod linkage, so this fixture links every pod as a dynamic framework.
linkage = ENV['USE_FRAMEWORKS'] || 'dynamic'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'C15tBare' do
  config = use_native_modules!

  # C15tReactNative carries its core and Apple services. Autolink that one pod;
  # a separate C15tCore pod would create a second consent authority in this process.

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Resource bundle targets keep their pod's own floor, such as async-storage's
    # 13.4, which current Xcode refuses to build. Lift every pod to the app's floor.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build|
        floor = build.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if floor && Gem::Version.new(floor) < Gem::Version.new('16.4')
          build.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
        end
      end
    end
  end
end
