		"test": "bun scripts/install-packed.ts && tsc --noEmit && vitest run"
	},
	"dependencies": {
		"@inth/nextjs": "workspace:*",
		"@inth/react": "workspace:*",
		"@inth/sdk": "workspace:*",
		"@inth/tanstack-start": "workspace:*"
	},
	"devDependencies": {
		"@c15t/next-compat-shared": "workspace:*",
		"@types/node": "25.5.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitest/coverage-istanbul": "4.1.10",
		"jsdom": "^25.0.0",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"vitest": "4.1.10"
	}
}
