{
  "name": "@inth/angular-compat-20",
  "version": "0.0.0",
  "private": true,
  "description": "Compatibility fixture: the oldest Angular version @inth/angular supports.",
  "type": "module",
  "scripts": {
    "build": "ng build",
    "check-types": "node install-package.mjs && tsc --noEmit -p tsconfig.app.json",
    "prebuild": "node install-package.mjs",
    "start": "node dist/angular-20/server/server.mjs"
  },
  "dependencies": {
    "@angular/common": "20.0.7",
    "@angular/core": "20.0.7",
    "@angular/forms": "20.0.7",
    "@angular/platform-browser": "20.0.7",
    "@angular/platform-server": "20.0.7",
    "@angular/router": "20.0.7",
    "@angular/ssr": "20.0.6",
    "@inth/angular": "workspace:*",
    "@inth/integrations": "workspace:*",
    "@inth/sdk": "workspace:*",
    "express": "5.1.0",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.0.6",
    "@angular/cli": "20.0.6",
    "@angular/compiler": "20.0.7",
    "@angular/compiler-cli": "20.0.7",
    "@types/express": "5.0.3",
    "@types/node": "22.20.5",
    "typescript": "5.8.3"
  }
}
