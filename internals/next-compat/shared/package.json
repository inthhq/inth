{
	"name": "@inth/next-compat-shared",
	"version": "0.0.0",
	"private": true,
	"description": "Shared fixture routes, probe, and Vitest suites for the @inth/nextjs compatibility matrix.",
	"type": "module",
	"exports": {
		"./config": "./src/config.ts",
		"./consent-shell": "./src/consent-shell.tsx",
		"./probe": "./src/probe.tsx",
		"./fixture": "./src/fixture/index.ts",
		"./fixture/node-adapter": "./src/fixture/node-adapter.ts",
		"./network-beacons": "./src/network-beacons.tsx",
		"./sibling-beacon": "./src/sibling-beacon.tsx",
		"./gated-embed": "./src/gated-embed.tsx"
	},
	"scripts": {
		"check-types": "tsrs --noEmit",
		"fmt": "vp fmt -c ../../../oxfmt.sdk.config.ts --write .",
		"lint": "vp lint -c ../../../oxlint.sdk.config.ts ."
	},
	"dependencies": {
		"@inth/nextjs": "workspace:*",
		"@inth/sdk": "workspace:*"
	},
	"devDependencies": {
		"@inth/typescript-config": "workspace:*",
		"@types/node": "25.5.0",
		"@types/react": "19.2.17",
		"@vitest/coverage-istanbul": "catalog:",
		"jsdom": "25.0.1",
		"playwright": "catalog:",
		"react": "19.2.7",
		"tsrs": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
