{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "ui": "tui",
  "concurrency": "20",
  "tasks": {
    "@inth/cli#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": ["INTH_CODESIGN_IDENTITY"]
    },
    "@inth/cli#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["INTH_CODESIGN_IDENTITY"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".nuxt/**",
        ".output/**",
        "dist/**",
        "dist-types/**",
        "storybook-static/**",
        "src/version.ts"
      ],
      "env": ["WITH_RSDOCTOR"]
    },
    "@inth/sdk#build": {
      "dependsOn": [
        "@inth/sdk-browser#build",
        "@inth/sdk-core#build",
        "@inth/sdk-dev-tools#build",
        "@inth/sdk-iab#build",
        "@inth/sdk-schema#build",
        "@inth/sdk-translations#build",
        "@inth/sdk-ui#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!README.md"],
      "outputs": ["lib/**"]
    },
    "@inth/sdk-core#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/scripts/prune-dist-types.ts",
        "$TURBO_ROOT$/scripts/manifest-utils.ts",
        "$TURBO_ROOT$/packages/sdk/shared/rslib-modules.ts",
        "$TURBO_ROOT$/packages/sdk/shared/rslib-utils.ts",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**"
      ],
      "outputs": ["dist/**", "dist-types/**", "src/version.ts"],
      "env": ["WITH_RSDOCTOR"]
    },
    "@inth/sdk-schema#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/sdk/shared/rslib-modules.ts",
        "$TURBO_ROOT$/packages/sdk/shared/rslib-utils.ts",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**"
      ],
      "outputs": ["dist/**", "dist-types/**"],
      "env": ["WITH_RSDOCTOR"]
    },
    "@inth/react#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
      ],
      "outputs": ["dist/**", "dist-types/**", "src/version.ts"],
      "env": ["WITH_RSDOCTOR"]
    },
    "@inth/nextjs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
      ],
      "outputs": ["dist/**", "dist-types/**", "src/version.ts"],
      "env": ["WITH_RSDOCTOR"]
    },
    "@inth/tanstack-start#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
      ],
      "outputs": ["dist/**", "dist-types/**", "src/version.ts"],
      "env": ["WITH_RSDOCTOR"]
    },
    "@inth/fixture-nuxt#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json"
      ],
      "outputs": [".nuxt/**", ".output/**", ".vercel/output/**"],
      "env": ["VERCEL", "NITRO_PRESET", "NUXT_PUBLIC_INTH_PROJECT_URL"]
    },
    "@inth/fixture-nuxt-vapor#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json"
      ],
      "outputs": [".nuxt/**", ".output/**", ".vercel/output/**"],
      "env": [
        "VERCEL",
        "NITRO_PRESET",
        "NUXT_PUBLIC_INTH_PROJECT_URL",
        "INTH_NUXT_FUTURE"
      ]
    },
    "@inth/fixture-tanstack-start#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json"
      ],
      "outputs": ["dist/**"],
      "env": ["VERCEL", "VITE_INTH_PROJECT_URL"]
    },
    "@inth/benchmarking#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json"
      ]
    },
    "@inth/svelte#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
      ],
      "outputs": ["dist/**", "src/lib/version.ts"]
    },
    "@inth/vue#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
      ],
      "outputs": ["dist/**"]
    },
    "@inth/nuxt#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
      ],
      "outputs": ["dist/**"]
    },
    "fmt": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxfmt.sdk.config.ts"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.sdk.config.ts"],
      "dependsOn": ["transit"]
    },
    "check-types": {
      "dependsOn": ["build", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "@inth/playground#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["^build"],
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/sdk-iab#dev",
        "@inth/nextjs#dev",
        "@inth/react#dev",
        "@inth/sdk-schema#dev",
        "@inth/integrations#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "@inth/fixture-nuxt#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["^build"],
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/sdk-schema#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "@inth/fixture-tanstack-start#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["^build"],
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/react#dev",
        "@inth/sdk-schema#dev",
        "@inth/tanstack-start#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "astro-demo#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["^build"],
      "with": [
        "@inth/sdk#dev",
        "@inth/astro#dev",
        "@inth/sdk-core#dev",
        "@inth/sdk-iab#dev",
        "@inth/sdk-schema#dev",
        "@inth/svelte#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "sveltekit-demo#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "dependsOn": ["^build"],
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/sdk-iab#dev",
        "@inth/sdk-schema#dev",
        "@inth/svelte#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "@inth/nextjs-browser-bench#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/nextjs#dev",
        "@inth/react#dev",
        "@inth/sdk-schema#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "@inth/tanstack-start-browser-bench#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/react#dev",
        "@inth/sdk-schema#dev",
        "@inth/tanstack-start#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "@inth/astro-browser-bench#build": {
      "dependsOn": ["^build"],
      "env": [
        "INTH_BENCH_ASTRO_MODE",
        "INTH_BENCH_ORIGIN",
        "INTH_BENCH_OUT_DIR"
      ],
      "outputs": [".astro/**", "dist/**", "dist-baseline/**", "dist-hosted/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json"
      ]
    },
    "@inth/astro-browser-bench#dev": {
      "cache": false,
      "interruptible": true,
      "persistent": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/astro#dev",
        "@inth/sdk-core#dev",
        "@inth/sdk-schema#dev",
        "@inth/svelte#dev",
        "@inth/sdk-translations#dev"
      ]
    },
    "@inth/nuxt-browser-bench#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/sdk-schema#dev",
        "@inth/sdk-translations#dev",
        "@inth/nuxt#dev"
      ]
    },
    "@inth/sveltekit-browser-bench#build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "build/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json"
      ]
    },
    "@inth/sveltekit-browser-bench#dev": {
      "cache": false,
      "interruptible": true,
      "persistent": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/sdk-schema#dev",
        "@inth/svelte#dev",
        "@inth/sdk-translations#dev"
      ]
    },
    "@inth/css-layer-preview#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/nextjs#dev",
        "@inth/react#dev",
        "@inth/sdk-schema#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "@inth/tw3-css-test#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/nextjs#dev",
        "@inth/react#dev",
        "@inth/sdk-schema#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "@inth/tw4-css-test#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/nextjs#dev",
        "@inth/react#dev",
        "@inth/sdk-schema#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "@inth/no-tw-css-test#dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "with": [
        "@inth/sdk#dev",
        "@inth/sdk-core#dev",
        "@inth/nextjs#dev",
        "@inth/react#dev",
        "@inth/sdk-schema#dev",
        "@inth/sdk-translations#dev",
        "@inth/sdk-ui#dev"
      ]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "bundle-bench": {
      "dependsOn": ["^build"],
      "outputs": ["report/**", "dist/**"]
    },
    "test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": [
        "coverage/coverage-summary.json",
        "coverage/coverage-final.json",
        "coverage/html/**"
      ],
      "env": ["INTH_TEST_PG_URL", "INTH_TEST_MYSQL_URL"]
    },
    "@inth/react-native#test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": [
        "coverage/coverage-summary.json",
        "coverage/coverage-final.json",
        "coverage/html/**"
      ],
      "env": [
        "INTH_TEST_PG_URL",
        "INTH_TEST_MYSQL_URL",
        "C15T_COVERAGE_RATCHET"
      ]
    },
    "@inth/react-native#test:coverage": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": [
        "coverage/coverage-summary.json",
        "coverage/coverage-final.json",
        "coverage/html/**"
      ]
    },
    "@inth/next-compat-15-app#check-types": {
      "dependsOn": []
    },
    "@inth/next-compat-15-pages#check-types": {
      "dependsOn": []
    },
    "@inth/next-compat-16-app#check-types": {
      "dependsOn": []
    },
    "@inth/next-compat-16-cache-components#check-types": {
      "dependsOn": []
    },
    "@inth/next-compat-16-pages#check-types": {
      "dependsOn": []
    },
    "@inth/next-compat-16-static-export#check-types": {
      "dependsOn": []
    },
    "test:compat": {
      "cache": false,
      "dependsOn": ["build", "^build"],
      "env": [
        "COMPAT_FORCE_BUILD",
        "COMPAT_SKIP_BUILD",
        "COMPAT_PRINT_SERVER_LOGS"
      ],
      "outputs": []
    },
    "@inth/next-compat-16-static-export#test:compat": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "COMPAT_FORCE_BUILD",
        "COMPAT_SKIP_BUILD",
        "COMPAT_PRINT_SERVER_LOGS"
      ],
      "outputs": []
    },
    "test-storybook": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test:parity": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": [
        "REACT_STORYBOOK_URL",
        "SVELTE_STORYBOOK_URL",
        "VUE_STORYBOOK_URL",
        "SOLID_STORYBOOK_URL",
        "ANGULAR_STORYBOOK_URL",
        "PARITY_FRAMEWORKS"
      ]
    },
    "bench": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "outputs": [".benchmarks/**"]
    },
    "bench:ci": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "outputs": [".benchmarks/**"]
    },
    "bench:nightly": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "outputs": [".benchmarks/**"]
    },
    "@inth/consent-observers#test": {
      "dependsOn": ["build", "^build", "transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/internals/next-compat/shared/scripts/pack.ts"
      ],
      "outputs": []
    },
    "@inth/integrations#test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": [
        "coverage/coverage-summary.json",
        "coverage/coverage-final.json",
        "coverage/html/**"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "@inth/integrations#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!docs/**",
        "!AGENTS.md",
        "!SKILL.md",
        "!README.md",
        "!readme.json",
        "$TURBO_ROOT$/packages/sdk/shared/**",
        "$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
      ],
      "outputs": ["dist/**", "dist-types/**"],
      "env": ["WITH_RSDOCTOR"]
    },
    "build:docs": {
      "inputs": [
        "$TURBO_ROOT$/packages/sdk/docs/**",
        "$TURBO_ROOT$/scripts/docs-origin.ts",
        "$TURBO_ROOT$/scripts/generate-package-docs.ts",
        "$TURBO_ROOT$/scripts/package-skill.ts",
        "$TURBO_ROOT$/scripts/package-doc-entry-points.ts",
        "$TURBO_ROOT$/scripts/rewrite-package-doc-links.ts",
        "package.json"
      ],
      "outputs": ["docs/**", "skills/**", "AGENTS.md", "SKILL.md"]
    },
    "check-types:test": {
      "dependsOn": ["build", "^build"]
    },
    "@inth/next-bundle-bench#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "sveltekit-demo#build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/**", "build/**"]
    },
    "@inth/conformance#test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": []
    },
    "@inth/parity-runner#test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": []
    },
    "@inth/sdk-dev-tools#test": {
      "dependsOn": ["build", "^build", "transit", "@inth/sdk-iab#build"],
      "outputs": []
    },
    "@inth/benchmarking#test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": []
    },
    "@inth/playground#test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": []
    }
  }
}
