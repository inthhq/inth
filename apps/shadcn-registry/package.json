{
  "name": "@inth/shadcn-registry",
  "private": true,
  "description": "Source and build for the Inth shadcn registry served at c15t.com/r.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check-types": "tsrs --noEmit && tsrs -p tsconfig.radix.json && tsrs -p tsconfig.base.json && tsrs -p tsconfig.aria.json && bun scripts/check-frameworks.ts",
    "fixtures": "bun scripts/fixtures.ts",
    "fmt": "vp fmt -c ../../oxfmt.sdk.config.ts .",
    "lint": "vp lint -c ../../oxlint.sdk.config.ts .",
    "test": "vp test run"
  },
  "dependencies": {
    "@inth/nextjs": "workspace:*",
    "@inth/react": "workspace:*",
    "@inth/sdk": "workspace:*",
    "@inth/tanstack-start": "workspace:*"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@inth/typescript-config": "workspace:*",
    "@rsbuild/core": "1.7.5",
    "@tanstack/react-start": "1.168.60",
    "@types/node": "25.5.0",
    "@types/react": "19.2.17",
    "@vitest/coverage-istanbul": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jsdom": "25.0.1",
    "lucide-react": "^1.23.0",
    "playwright": "catalog:",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.7",
    "shadcn": "4.21.4",
    "tsrs": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
