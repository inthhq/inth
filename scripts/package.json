{
	"name": "@inth/repo-scripts",
	"private": true,
	"description": "Repository tooling for the SDK: docs generation, fixtures, publish checks and their tests.",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"bench:compare": "cd .. && vpx benchmarks/shared/run-compare.ts",
		"bench:frameworks": "cd .. && vpx benchmarks/shared/run-frameworks.ts",
		"bench:gate": "cd .. && bun scripts/benchmark-run.ts gate",
		"bench:important-react": "cd .. && bun scripts/run-important-react-benches.ts",
		"bench:mobile": "cd .. && pnpm --dir benchmarks/mobile run bench",
		"bench:test": "cd .. && pnpm --dir benchmarks/shared run test",
		"check:publish-artifacts": "cd .. && bun scripts/check-publish-artifacts.ts",
		"check:react-native-autolink": "cd .. && bun scripts/react-native-autolink.ts",
		"clear-cache": "cd .. && bun scripts/clear-rslib-cache.ts",
		"compat:styles:matrix": "cd .. && vpx scripts/verify-tailwind-matrix.ts",
		"compat:styles:review": "cd .. && node scripts/css-layer-review.mjs",
		"compat:styles:verify": "cd .. && node scripts/verify-css-layer.mjs",
		"e2e:consent": "cd .. && node scripts/verify-consent-e2e.mjs",
		"fmt:check": "cd .. && node scripts/on-sdk-paths.ts vp fmt -c oxfmt.sdk.config.ts --ignore-path .gitignore --check",
		"fmt:docs": "cd .. && bun scripts/format-docs-code.ts && remark ./packages/sdk/docs --ext mdx --output --use remark-mdx --use remark-frontmatter --use remark-preset-lint-recommended --use remark-preset-lint-consistent",
		"fmt:repo": "cd .. && node scripts/on-sdk-paths.ts vp fmt -c oxfmt.sdk.config.ts --ignore-path .gitignore",
		"generate:native-iab-copy": "cd .. && bun scripts/generate-native-iab-copy.ts",
		"generate:package-docs": "cd .. && bun scripts/generate-package-docs.ts",
		"generate:readmes": "cd .. && vpx scripts/generate-readme.ts",
		"generate:v1-openapi": "cd .. && bun scripts/generate-v1-openapi.ts",
		"generate:webview-consent-scripts": "cd .. && bun scripts/generate-webview-consent-scripts.ts",
		"lint:docs": "cd .. && remark ./packages/sdk/docs --ext mdx --output --use remark-mdx --use remark-frontmatter --use remark-preset-lint-recommended --use remark-preset-lint-consistent --use ./scripts/remark-lint-canonical-integrations.mjs",
		"lint:repo": "cd .. && node scripts/on-sdk-paths.ts vp lint -c oxlint.sdk.config.ts --disable-nested-config",
		"lint:testids": "cd .. && bun internals/conformance/src/lint/testid-lint.ts",
		"repro:tw3-css": "cd .. && bun scripts/repro-tw3-css-entrypoints.ts",
		"setup:docs": "cd .. && vpx scripts/setup-docs.ts",
		"test:scripts": "cd .. && vp test run --config scripts/vitest.config.ts",
		"vercel-build": "cd .. && vpx scripts/setup-docs.ts --vercel"
	},
	"dependencies": {},
	"devDependencies": {
		"@babel/parser": "7.28.5",
		"@rsbuild/core": "1.7.5",
		"@rsbuild/plugin-react": "1.4.6",
		"@rsdoctor/rspack-plugin": "1.5.17",
		"@rslib/core": "0.23.2",
		"@rspack/resolver-binding-wasm32-wasi": "0.2.8",
		"@types/bun": "1.3.9",
		"@types/mdast": "4.0.4",
		"@types/node": "25.5.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/semver": "7.7.1",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-istanbul": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"baseline-browser-mapping": "latest",
		"decode-named-character-reference": "1.3.0",
		"esbuild": "^0.28.1",
		"fast-glob": "3.3.3",
		"json5": "2.2.3",
		"jsonc-parser": "3.3.1",
		"leadtype": "^0.2.1",
		"mdast-util-compact": "5.0.0",
		"mdast-util-mdx": "3.0.0",
		"mdast-util-mdx-jsx": "3.2.0",
		"mdast-util-mdxjs-esm": "2.0.1",
		"mdast-util-to-markdown": "2.1.2",
		"mdast-util-to-string": "4.0.0",
		"openapi-typescript": "7.13.0",
		"playwright": "catalog:",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"remark": "15.0.1",
		"remark-cli": "12.0.1",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"remark-mdx": "3.1.1",
		"remark-preset-lint-consistent": "6.0.1",
		"remark-preset-lint-recommended": "7.0.1",
		"semver": "7.8.5",
		"tsx": "4.23.0",
		"typescript": "6.0.3",
		"ultracite": "7.10.7",
		"unified": "11.0.5",
		"unist-builder": "4.0.0",
		"unist-util-is": "6.0.1",
		"unist-util-visit": "5.1.0",
		"valibot": "1.4.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-react": "2.2.0",
		"yaml": "2.9.0"
	}
}
