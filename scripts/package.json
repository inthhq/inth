{
	"name": "c15t-workspace",
	"private": true,
	"description": "Developer-first consent management platform for cookie banners, preference centers, Consent Mode v2, IAB TCF, and self-hosted CMP workflows.",
	"homepage": "https://c15t.com",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git"
	},
	"type": "module",
	"scripts": {
		"bench:compare": "tsx benchmarks/shared/run-compare.ts",
		"bench:frameworks": "tsx benchmarks/shared/run-frameworks.ts",
		"bench:gate": "bun scripts/benchmark-run.ts gate",
		"bench:important-react": "bun scripts/run-important-react-benches.ts",
		"bench:mobile": "pnpm --dir benchmarks/mobile run bench",
		"bench:test": "pnpm --dir benchmarks/shared run test",
		"check:publish-artifacts": "bun scripts/check-publish-artifacts.ts",
		"check:react-native-autolink": "bun scripts/react-native-autolink.ts",
		"clear-cache": "bun scripts/clear-rslib-cache.ts",
		"compat:styles:matrix": "tsx scripts/verify-tailwind-matrix.ts",
		"compat:styles:review": "node scripts/css-layer-review.mjs",
		"compat:styles:verify": "node scripts/verify-css-layer.mjs",
		"e2e:consent": "node scripts/verify-consent-e2e.mjs",
		"fmt:check": "oxfmt . --check",
		"fmt:docs": "bun scripts/format-docs-code.ts && remark ./docs --ext mdx --output --use remark-mdx --use remark-frontmatter --use remark-preset-lint-recommended --use remark-preset-lint-consistent",
		"fmt:repo": "oxfmt .",
		"generate:native-iab-copy": "bun scripts/generate-native-iab-copy.ts",
		"generate:package-docs": "bun scripts/generate-package-docs.ts",
		"generate:readmes": "tsx scripts/generate-readme.ts",
		"generate:umbrella": "bun scripts/generate-umbrella-exports.ts",
		"generate:webview-consent-scripts": "bun scripts/generate-webview-consent-scripts.ts",
		"knip": "knip",
		"lint:docs": "remark ./docs --ext mdx --output --use remark-mdx --use remark-frontmatter --use remark-preset-lint-recommended --use remark-preset-lint-consistent --use ./scripts/remark-lint-canonical-integrations.mjs",
		"lint:repo": "oxlint .",
		"lint:testids": "bun internals/conformance/src/lint/testid-lint.ts",
		"release": "pnpm run tegami publish",
		"repro:tw3-css": "bun scripts/repro-tw3-css-entrypoints.ts",
		"setup:docs": "tsx scripts/setup-docs.ts",
		"tegami": "bun scripts/tegami.ts",
		"tegami:mobile": "bun scripts/tegami-mobile.ts",
		"test:affected": "bun scripts/run-affected-tests.ts",
		"test:scripts": "vitest run --config scripts/vitest.config.ts",
		"vercel-build": "tsx scripts/setup-docs.ts --vercel",
		"version": "pnpm run tegami version"
	},
	"dependencies": {},
	"devDependencies": {
		"@babel/parser": "7.28.5",
		"@rsbuild/core": "1.7.5",
		"@rsbuild/plugin-react": "1.4.6",
		"@rsdoctor/rspack-plugin": "1.5.17",
		"@rslib/core": "0.23.2",
		"@rspack/resolver-binding-wasm32-wasi": "0.2.8",
		"@types/bun": "1.3.9",
		"@types/mdast": "4.0.4",
		"@types/node": "25.5.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/semver": "7.7.1",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/browser": "4.1.10",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-istanbul": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"baseline-browser-mapping": "latest",
		"decode-named-character-reference": "1.3.0",
		"esbuild": "^0.28.1",
		"fast-glob": "3.3.3",
		"json5": "2.2.3",
		"jsonc-parser": "3.3.1",
		"knip": "6.1.1",
		"leadtype": "^0.2.1",
		"mdast-util-compact": "5.0.0",
		"mdast-util-mdx": "3.0.0",
		"mdast-util-mdx-jsx": "3.2.0",
		"mdast-util-mdxjs-esm": "2.0.1",
		"mdast-util-to-markdown": "2.1.2",
		"mdast-util-to-string": "4.0.0",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"playwright": "1.61.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"remark": "15.0.1",
		"remark-cli": "12.0.1",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"remark-mdx": "3.1.1",
		"remark-preset-lint-consistent": "6.0.1",
		"remark-preset-lint-recommended": "7.0.1",
		"semver": "7.8.5",
		"tegami": "1.5.0",
		"tsx": "4.23.0",
		"typescript": "6.0.3",
		"ultracite": "7.10.7",
		"unified": "11.0.5",
		"unist-builder": "4.0.0",
		"unist-util-is": "6.0.1",
		"unist-util-visit": "5.1.0",
		"vite": "8.1.3",
		"vitest": "4.1.10",
		"vitest-browser-react": "2.2.0",
		"yaml": "2.9.0"
	}
}
