{
	"description": "Whether the ATT sequence treats an IAB TCF choice as granting marketing. `vendors` maps each registered vendor to its purposes on consent after publisher restrictions; the consent basis is their union, plus 1, 3 and 4 when ad tech providers are listed. `purposes` is the web half, `iabPurposesToC15tConsents(purposeConsents, basis).marketing`. `marketing` also needs a consented vendor that asks consent for a deciding marketing purpose, or a consented ad tech provider.",
	"cases": [
		{
			"name": "accept all with a list that never asks for purpose 2",
			"purposeConsents": [1, 3, 4, 7],
			"vendors": { "1": [1, 3, 4, 7], "2": [1, 7] },
			"vendorConsents": [1, 2],
			"adTechProvidersListed": false,
			"adTechProviderConsents": [],
			"expected": { "purposes": true, "marketing": true }
		},
		{
			"name": "purposes 1 to 4 consented but every vendor refused",
			"purposeConsents": [1, 2, 3, 4],
			"vendors": { "1": [1, 2, 3, 4], "2": [1, 3] },
			"vendorConsents": [],
			"adTechProvidersListed": false,
			"adTechProviderConsents": [],
			"expected": { "purposes": true, "marketing": false }
		},
		{
			"name": "only a measurement vendor consented",
			"purposeConsents": [1, 3, 4, 7],
			"vendors": { "1": [1, 3, 4], "2": [7] },
			"vendorConsents": [2],
			"adTechProvidersListed": false,
			"adTechProviderConsents": [],
			"expected": { "purposes": true, "marketing": false }
		},
		{
			"name": "a deciding purpose refused",
			"purposeConsents": [2, 3],
			"vendors": { "1": [2, 3, 4] },
			"vendorConsents": [1],
			"adTechProvidersListed": false,
			"adTechProviderConsents": [],
			"expected": { "purposes": false, "marketing": false }
		},
		{
			"name": "no vendor asks for a marketing purpose, so all three decide",
			"purposeConsents": [1, 2, 3, 4, 7],
			"vendors": { "1": [7] },
			"vendorConsents": [1],
			"adTechProvidersListed": false,
			"adTechProviderConsents": [],
			"expected": { "purposes": true, "marketing": false }
		},
		{
			"name": "a consented ad tech provider is someone who could track",
			"purposeConsents": [1, 3, 4],
			"vendors": { "1": [1] },
			"vendorConsents": [],
			"adTechProvidersListed": true,
			"adTechProviderConsents": [89],
			"expected": { "purposes": true, "marketing": true }
		},
		{
			"name": "ad tech providers listed but none consented",
			"purposeConsents": [1, 3, 4],
			"vendors": { "1": [1] },
			"vendorConsents": [1],
			"adTechProvidersListed": true,
			"adTechProviderConsents": [],
			"expected": { "purposes": true, "marketing": false }
		},
		{
			"name": "reject all",
			"purposeConsents": [],
			"vendors": { "1": [1, 2, 3, 4] },
			"vendorConsents": [],
			"adTechProvidersListed": false,
			"adTechProviderConsents": [],
			"expected": { "purposes": false, "marketing": false }
		}
	]
}
