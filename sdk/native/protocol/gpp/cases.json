		"repository": "https://github.com/InteractiveAdvertisingBureau/Global-Privacy-Platform",
		"usNationalVersion": 2,
		"inAppKeys": "Core/CMP API Specification.md, \"In-App Key Names\"; Sections/EEA/GPPExtension: IAB Europe TCF.md, \"Key Names\""
	},
