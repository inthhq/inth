		{
			"id": "usnat-distinct-values",
			"description": "Every US National field holds a different in-range value, so a field read from the wrong offset decodes wrong.",
			"sections": [
				{
					"id": 7,
					"usnat": {
						"Version": 2,
						"SharingNotice": 2,
						"SaleOptOutNotice": 0,
						"SharingOptOutNotice": 1,
						"TargetedAdvertisingOptOutNotice": 2,
						"SensitiveDataProcessingOptOutNotice": 0,
						"SensitiveDataLimitUseNotice": 1,
						"SaleOptOut": 2,
						"SharingOptOut": 0,
						"TargetedAdvertisingOptOut": 1,
						"SensitiveDataProcessing": [
							2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2, 0, 1, 2
						],
						"KnownChildSensitiveDataConsents": [0, 1, 2],
						"PersonalDataConsents": 1,
						"MspaCoveredTransaction": 1,
						"MspaOptOutOptionMode": 0,
						"MspaServiceProviderMode": 1
					},
					"gpc": true
				}
			],
			"expected": "DBABLA~ChhhhhhhhhlE.YA"
		},
		{
			"id": "usnat-zero-values",
