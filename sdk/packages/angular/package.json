{
	"name": "@c15t/angular",
	"version": "3.2.0-canary.0",
	"description": "Angular cookie consent banner for c15t, with a consent dialog and preference center. Standalone components, signals and zoneless change detection.",
	"keywords": [
		"angular",
		"angular-cookie-consent",
		"banner",
		"ccpa",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management-platform",
		"consent-manager",
		"consent-mode-v2",
		"cookie",
		"cookie-banner",
		"cookie-consent",
		"gdpr",
		"global-privacy-control",
		"google-consent-mode",
		"headless",
		"iab-tcf",
		"preference-center",
		"privacy",
		"signals",
		"typescript",
		"user-consent"
	],
	"homepage": "https://c15t.com/docs/frameworks/angular/quickstart",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/angular"
	},
	"files": [
		"dist",
		"!dist/package.json",
		"!dist/!(schematics)/package.json",
		"!dist/README.md",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"docs",
		"AGENTS.md",
		"SKILL.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"module": "./dist/fesm2022/c15t-angular.mjs",
	"types": "./dist/types/c15t-angular.d.ts",
	"exports": {
		"./package.json": "./package.json",
		"./styles.css": "./dist/styles.css",
		"./iab/styles.css": "./dist/iab/styles.css",
		"./devtools": {
			"types": "./dist/types/c15t-angular-devtools.d.ts",
			"default": "./dist/fesm2022/c15t-angular-devtools.mjs"
		},
		"./postcss-tailwind3": {
			"types": "./dist/postcss-tailwind3/index.d.ts",
			"default": "./dist/postcss-tailwind3/index.mjs"
		},
		"./ssr": {
			"types": "./dist/types/c15t-angular-ssr.d.ts",
			"default": "./dist/fesm2022/c15t-angular-ssr.mjs"
		},
		"./testing": {
			"types": "./dist/types/c15t-angular-testing.d.ts",
			"default": "./dist/fesm2022/c15t-angular-testing.mjs"
		},
		"./consent-dialog": {
			"types": "./dist/types/c15t-angular-consent-dialog.d.ts",
			"default": "./dist/fesm2022/c15t-angular-consent-dialog.mjs"
		},
		"./consent-dialog-trigger": {
			"types": "./dist/types/c15t-angular-consent-dialog-trigger.d.ts",
			"default": "./dist/fesm2022/c15t-angular-consent-dialog-trigger.mjs"
		},
		"./consent-gate": {
			"types": "./dist/types/c15t-angular-consent-gate.d.ts",
			"default": "./dist/fesm2022/c15t-angular-consent-gate.mjs"
		},
		"./consent-root": {
			"types": "./dist/types/c15t-angular-consent-root.d.ts",
			"default": "./dist/fesm2022/c15t-angular-consent-root.mjs"
		},
		"./consent-widget": {
			"types": "./dist/types/c15t-angular-consent-widget.d.ts",
			"default": "./dist/fesm2022/c15t-angular-consent-widget.mjs"
		},
		"./iab": {
			"types": "./dist/types/c15t-angular-iab.d.ts",
			"default": "./dist/fesm2022/c15t-angular-iab.mjs"
		},
		"./primitives": {
			"types": "./dist/types/c15t-angular-primitives.d.ts",
			"default": "./dist/fesm2022/c15t-angular-primitives.mjs"
		},
		".": {
			"types": "./dist/types/c15t-angular.d.ts",
			"default": "./dist/fesm2022/c15t-angular.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && bun run build:schematics",
		"build:docs": "bun ../../scripts/generate-package-docs.ts @c15t/angular",
		"build:schematics": "tsc -p schematics/tsconfig.json && bun schematics/copy-assets.mjs",
		"check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
		"dev": "ng-packagr -p ng-package.json -c tsconfig.lib.json --watch",
		"fmt": "bun oxfmt .",
		"lint": "bun oxlint ./src",
		"prepack": "bun run build:docs && bun run build",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@c15t/core": "workspace:*",
		"@c15t/dev-tools": "workspace:*",
		"@c15t/iab": "workspace:*",
		"@c15t/schema": "workspace:*",
		"@c15t/translations": "workspace:*",
		"@c15t/ui": "workspace:*",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "2.9.6",
		"@analogjs/vitest-angular": "2.9.6",
		"@angular-devkit/core": "22.2.6",
		"@angular-devkit/schematics": "22.2.6",
		"@angular/build": "22.2.6",
		"@angular/cdk": "22.2.6",
		"@angular/common": "22.2.5",
		"@angular/compiler": "22.2.5",
		"@angular/compiler-cli": "22.2.5",
		"@angular/core": "22.2.5",
		"@angular/forms": "22.2.5",
		"@angular/platform-browser": "22.2.5",
		"@angular/platform-server": "22.2.5",
		"@angular/router": "22.2.5",
		"@angular/ssr": "22.2.6",
		"@c15t/conformance": "workspace:*",
		"@c15t/integrations": "workspace:*",
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@schematics/angular": "22.2.6",
		"jsdom": "^25.0.0",
		"ng-packagr": "22.2.6",
		"rxjs": "7.8.2",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@angular-devkit/schematics": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@angular/cdk": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@angular/compiler": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@angular/forms": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@angular/platform-browser": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@angular/platform-server": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@angular/ssr": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"@schematics/angular": "^20.0.0 || ^21.0.0 || ^22.0.0",
		"rxjs": "^6.5.3 || ^7.4.0",
		"typescript": ">=5.8.0"
	},
	"peerDependenciesMeta": {
		"@angular-devkit/schematics": {
			"optional": true
		},
		"@angular/cdk": {
			"optional": true
		},
		"@angular/platform-server": {
			"optional": true
		},
		"@angular/ssr": {
			"optional": true
		},
		"@schematics/angular": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"ng-add": {
		"save": "dependencies"
	},
	"schematics": "./dist/schematics/collection.json"
}
