{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "bench/**/*.ts",
    "experiments/node/**/*.ts",
    "e2e/**/*.ts",
    "playwright.agent.config.ts",
    "playwright.agent.live.config.ts"
  ],
  "exclude": [
    "src/inth.ts",
    "src/native/**",
    "test/native/**",
    "bench/native-auth.ts"
  ]
}
