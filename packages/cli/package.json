{
  "name": "@inth/cli",
  "version": "0.0.2",
  "description": "The inth command line interface",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inthhq/inth.git",
    "directory": "packages/cli"
  },
  "bin": {
    "inth": "scripts/run-native.js"
  },
  "files": [
    "scripts/run-native.js",
    "AGENT-USAGE.md",
    "output.schema.json",
    "docs",
    "LICENSE",
    "scripts/run-published.js",
    "AGENTS.md",
    "SKILL.md"
  ],
  "type": "module",
  "publishConfig": {
    "bin": {
      "inth": "scripts/run-published.js"
    },
    "access": "public",
    "executableFiles": [
      "scripts/run-published.js"
    ]
  },
  "scripts": {
    "build": "node scripts/build-scriptc.ts",
    "build:production": "node scripts/build-scriptc.ts --production",
    "build:native": "pnpm build",
    "dev": "pnpm build && node scripts/run-native.js",
    "dev:link": "pnpm build && npm link --ignore-scripts --no-audit --no-fund",
    "dev:unlink": "npm unlink --global @inth/cli --ignore-scripts --no-audit --no-fund",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.native.json",
    "bench": "node scripts/benchmark-scriptc.ts",
    "build:native:dynamic": "scriptc build experiments/node/inth.ts --dynamic -o dist-bin/inth-dynamic",
    "inth": "node scripts/run-native.js",
    "build:yao": "node scripts/build-yao.ts",
    "test:yao": "node scripts/verify-yao.ts",
    "assess:vendoring": "node scripts/assess-vendoring.ts",
    "assess:skills": "node scripts/assess-skills.ts",
    "assess:sentry": "node scripts/assess-sentry.ts",
    "assess:sentry:native": "node scripts/assess-sentry-native.ts",
    "build:scriptc:auth": "pnpm build",
    "test:scriptc": "node scripts/test-scriptc.ts",
    "bench:scriptc": "node scripts/benchmark-scriptc.ts",
    "bench:cross": "node scripts/benchmark-cross-cli.ts",
    "bench:auth": "node scripts/build-scriptc.ts --tests && node scripts/build-yao.ts --auth-bench && node scripts/benchmark-auth.ts",
    "bench:vercel": "node scripts/benchmark-vercel.ts",
    "bench:switch": "node scripts/build-scriptc.ts --tests && node scripts/build-yao.ts --selector && python3 scripts/benchmark-switch.py",
    "bench:switch:live": "python3 scripts/benchmark-switch.py --live",
    "build:node": "tsc -p tsconfig.build.json",
    "dev:node": "node experiments/node/inth.ts",
    "inth:node": "node build/node/experiments/node/inth.js",
    "inth:yao": "./dist-bin/yao/inth",
    "test": "node scripts/test-scriptc.ts",
    "bench:probe": "node scripts/benchmark.ts",
    "test:package": "node scripts/verify-package.ts",
    "package:native": "pnpm build:production && node scripts/package-native.ts",
    "test:e2e:agent": "node scripts/build-scriptc.ts --tests && playwright test --config playwright.agent.config.ts",
    "test:e2e:agent:live": "node scripts/build-scriptc.ts --tests && playwright test --config playwright.agent.live.config.ts",
    "prepack": "pnpm --workspace-root docs:bundle"
  },
  "devDependencies": {
    "@clack/prompts": "1.7.0",
    "@napi-rs/keyring": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "@yao-pkg/pkg": "6.22.0",
    "esbuild": "0.27.0",
    "inrepo": "0.0.9",
    "proper-lockfile": "4.1.2",
    "scriptc": "0.0.36",
    "typescript": "6.0.3",
    "zod": "4.5.4"
  },
  "optionalDependencies": {
    "@inth/cli-darwin-arm64": "workspace:*",
    "@inth/cli-linux-arm64": "workspace:*",
    "@inth/cli-linux-x64": "workspace:*",
    "@inth/cli-win32-x64": "workspace:*"
  }
}
