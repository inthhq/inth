{
	"name": "@inth/sdk-iab",
	"version": "3.2.0-canary.0",
	"private": true,
	"description": "IAB TCF CMP addon for c15t (TCF 2.4). Generates TC Strings and GPP strings, loads the Global Vendor List (GVL) and collects consent for programmatic advertising.",
	"keywords": [
		"cmp",
		"consent",
		"cookie-consent",
		"gdpr",
		"global-privacy-platform",
		"global-vendor-list",
		"gpp",
		"iab",
		"iab-tcf",
		"iab-tcf-2.4",
		"privacy",
		"programmatic-advertising",
		"tc-string",
		"tcf",
		"tcf-cmp",
		"transparency-consent-framework"
	],
	"homepage": "https://c15t.com/docs/frameworks/react/iab",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/sdk/iab"
	},
	"files": [
		"dist",
		"dist-types"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./headless": {
			"types": "./dist-types/headless.d.ts",
			"import": "./dist/headless.js",
			"default": "./dist/headless.js"
		},
		"./gpp": {
			"types": "./dist-types/gpp.d.ts",
			"import": "./dist/gpp.js",
			"default": "./dist/gpp.js"
		}
	},
	"scripts": {
		"build": "pnpm run prebuild && rslib build && node ../../../scripts/normalize-dist-types.mjs",
		"check-types": "pnpm run prebuild && tsc --noEmit",
		"dev": "sh -c 'pnpm run prebuild && rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "oxfmt -c ../../../oxfmt.sdk.config.ts .",
		"lint": "oxlint -c ../../../oxlint.sdk.config.ts ./src",
		"prebuild": "genversion --esm --semi src/version.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@iabtechlabtcf/core": "^1.5.22",
		"@inth/sdk-core": "workspace:*",
		"@inth/sdk-schema": "workspace:*"
	},
	"devDependencies": {
		"@c15t/conformance": "workspace:*",
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@iabgpp/cmpapi": "3.2.0",
		"@rslib/core": "0.23.2",
		"@types/node": "25.5.0",
		"@vitest/coverage-istanbul": "4.1.10",
		"genversion": "3.2.0",
		"jsdom": "25.0.1",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"typescript": "7.0.2",
		"vite": "8.1.3",
		"vitest": "4.1.10"
	}
}
