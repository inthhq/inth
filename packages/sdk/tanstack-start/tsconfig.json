{
	"extends": "@inth/typescript-config/react-library.json",
	"compilerOptions": {
		"rootDir": "src",
		"moduleResolution": "bundler",
		"types": ["vite-plus/test/matchers"],
		"paths": {
			"@inth/react": ["../react/dist-types/index.d.ts"],
			"@inth/react/*": ["../react/dist-types/*"],
			"~/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "src/**/__tests__/**"]
}
