{
	"extends": "@c15t/typescript-config/base.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"paths": {
			"~/*": ["../core/src/*", "./src/lib/*"],
			"#server-root": ["./src/lib/deferred/server-root.ts"]
		}
	},
	"include": ["src"],
	"exclude": [
		"node_modules",
		"dist",
		"src/**/__tests__/**",
		"src/**/*.test.ts",
		"src/**/*.spec.ts"
	]
}
