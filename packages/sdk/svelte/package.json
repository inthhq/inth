{
	"name": "@inth/svelte",
	"version": "3.2.0-canary.0",
	"description": "Svelte cookie consent banner for Svelte and SvelteKit, with a consent dialog and preference center. The Svelte package for inth.",
	"keywords": [
		"banner",
		"ccpa",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management-platform",
		"consent-manager",
		"consent-mode-v2",
		"cookie",
		"cookie-banner",
		"cookie-consent",
		"gdpr",
		"global-privacy-control",
		"google-consent-mode",
		"headless",
		"iab-tcf",
		"lgpd",
		"preference-center",
		"privacy",
		"privacy-compliance",
		"svelte",
		"svelte-cookie-consent",
		"sveltekit",
		"typescript",
		"user-consent",
		"web-privacy"
	],
	"homepage": "https://c15t.com/docs/frameworks/svelte/quickstart",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/sdk/svelte"
	},
	"files": [
		"dist",
		"styles.css",
		"iab",
		"!dist/**/__tests__/**",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"docs",
		"AGENTS.md",
		"SKILL.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"./dist/translations/*.js"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		">4.0": {
			"devtools": [
				"./dist/devtools.d.ts"
			],
			"dialog-panel": [
				"./dist/dialog-panel.d.ts"
			],
			"headless": [
				"./dist/headless.d.ts"
			],
			"kit": [
				"./dist/kit/index.d.ts"
			],
			"kit/locals": [
				"./dist/kit/app.d.ts"
			],
			"server": [
				"./dist/server/index.d.ts"
			],
			"vite": [
				"./dist/vite.d.ts"
			]
		}
	},
	"svelte": "./dist/index.js",
	"imports": {
		"#server-root": {
			"types": "./dist/deferred/server-root.d.ts",
			"browser": "./dist/deferred/server-root-browser.js",
			"default": "./dist/deferred/server-root.js"
		}
	},
	"exports": {
		"./styles.css": "./dist/styles.css",
		"./iab/styles.css": "./dist/iab/styles.css",
		"./postcss-tailwind3": {
			"types": "./dist/postcss-tailwind3.d.ts",
			"import": "./dist/postcss-tailwind3.js",
			"default": "./dist/postcss-tailwind3.js"
		},
		"./headless": {
			"types": "./dist/headless.d.ts",
			"svelte": "./dist/headless.js",
			"default": "./dist/headless.js"
		},
		"./devtools": {
			"types": "./dist/devtools.d.ts",
			"svelte": "./dist/devtools.js",
			"default": "./dist/devtools.js"
		},
		"./dialog-panel": {
			"types": "./dist/dialog-panel.d.ts",
			"svelte": "./dist/dialog-panel.js",
			"default": "./dist/dialog-panel.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js",
			"default": "./dist/testing.js"
		},
		"./kit": {
			"types": "./dist/kit/index.d.ts",
			"import": "./dist/kit/index.js",
			"default": "./dist/kit/index.js"
		},
		"./kit/locals": {
			"types": "./dist/kit/app.d.ts"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"import": "./dist/server/index.js",
			"default": "./dist/server/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js",
			"default": "./dist/vite.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./gpp": {
			"types": "./dist/gpp.d.ts",
			"import": "./dist/gpp.js",
			"default": "./dist/gpp.js"
		},
		"./generated": {
			"types": "./dist/generated.d.ts",
			"import": "./dist/generated.js",
			"default": "./dist/generated.js"
		},
		"./engine": {
			"types": "./dist/engine.d.ts",
			"import": "./dist/engine.js",
			"default": "./dist/engine.js"
		},
		"./translations/*": {
			"types": "./dist/translations/*.d.ts",
			"import": "./dist/translations/*.js",
			"default": "./dist/translations/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm run prebuild && svelte-package -o dist && pnpm run copy:dist:css && pnpm run clean:dist:test-artifacts && node ../shared/write-translation-entries.mjs dist",
		"build:docs": "bun ../../../scripts/generate-package-docs.ts @inth/svelte",
		"check-types": "pnpm run prebuild && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.kit2.json && tsc -p tsconfig.kit3.json",
		"clean:dist:test-artifacts": "bun --eval \"import { readdirSync, rmSync } from 'node:fs'; import { join } from 'node:path'; const walk = (dir) => { for (const entry of readdirSync(dir, { withFileTypes: true })) { const full = join(dir, entry.name); if (entry.isDirectory()) { if (entry.name === '__tests__') { rmSync(full, { recursive: true, force: true }); continue; } walk(full); continue; } if (/\\.(test|spec)\\.[cm]?[jt]sx?$/.test(entry.name)) { rmSync(full, { force: true }); } } }; walk('dist');\"",
		"copy:dist:css": "bun --eval \"import { copyFileSync, existsSync, mkdirSync } from 'node:fs'; import { dirname, join } from 'node:path'; const copy = (sourceRel, targetRel) => { const source = join(process.cwd(), sourceRel); const target = join(process.cwd(), targetRel); if (!existsSync(source)) throw new Error('Missing source CSS asset: ' + source); mkdirSync(dirname(target), { recursive: true }); copyFileSync(source, target); }; copy('src/styles.css', 'dist/styles.css'); copy('src/iab/styles.css', 'dist/iab/styles.css');\"",
		"dev": "pnpm run prebuild && svelte-package -o dist --watch",
		"fmt": "oxfmt -c ../../../oxfmt.sdk.config.ts .",
		"lint": "oxlint -c ../../../oxlint.sdk.config.ts ./src",
		"prebuild": "genversion --esm --semi src/lib/version.ts",
		"prepack": "pnpm run build:docs && pnpm run build",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@inth/sdk": "workspace:*",
		"clsx": "2.1.1",
		"esm-env": "1.2.2"
	},
	"devDependencies": {
		"@inth/conformance": "workspace:*",
		"@inth/typescript-config": "workspace:*",
		"@inth/vitest-config": "workspace:*",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.3.7",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@testing-library/jest-dom": "^6.0.0",
		"@testing-library/svelte": "^5.0.0",
		"@types/node": "25.5.0",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-istanbul": "4.1.10",
		"genversion": "3.2.0",
		"jsdom": "^25.0.0",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.5",
		"sveltekit-3": "npm:@sveltejs/kit@3.0.0",
		"typescript": "6.0.3",
		"vite": "^6.0.0",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.63.0 || ^3.0.0",
		"svelte": "^5.20.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	}
}
