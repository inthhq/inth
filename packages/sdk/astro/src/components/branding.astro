---
/**
 * The "Consent by" tag.
 *
 * Server-rendered with the same markup, classes and `data-testid` as the
 * Svelte and React banners, so the shared stylesheet positions it
 * identically and cross-framework tests compare like with like.
 *
 * Rendered by `<ConsentBanner />`; a site turns it off with
 * `<ConsentBanner hideBranding />`. Which brand it shows comes from the
 * consent snapshot, not from a prop. The browser-rendered banner builds the
 * same markup from the same model.
 */
import type { ConsentSnapshot } from '@inth/sdk/engine';
import type { Theme } from '@inth/sdk/ui/theme';
import { brandMarkSvg } from '@inth/sdk/ui/utils/branding';
import type { BrandingSurface } from '@inth/sdk/ui/utils/branding';
import { promptClassNames, resolveBrandingModel } from '@inth/astro/server';

interface Props {
	/** Render nothing. */
	hide?: boolean;
	/** Ship the DOM without the bundled stylesheet's class names. */
	noStyle?: boolean;
	/** The surface the tag sits on. */
	surface: BrandingSurface;
	/** The brand the server resolved. */
	branding: ConsentSnapshot['branding'];
	/** "Consent by", already resolved from the translation bundle. */
	securedBy: string;
	/** The host to attribute the referral to. */
	hostname?: string;
	/** The integration's `theme`, for the tag's `slots` entry. */
	theme?: Theme;
}

const { securedBy, ...input } = Astro.props;
const tag = resolveBrandingModel({
	...input,
	styles: promptClassNames.branding,
});
---

{
	tag && (
		<a
			class={tag.root.class}
			data-branding={tag.brand}
			data-testid={tag.testId}
			data-variant={tag.variant}
			href={tag.href}
			style={tag.root.style}
		>
			<span class={tag.classes.content} data-slot="tag-content">
				<span class={tag.classes.copy}>
					<span class={tag.classes.text}>{securedBy}</span>
				</span>
				{tag.brand === 'inth' ? (
					<span class={tag.classes.wordmark} dir="ltr" set:html={brandMarkSvg('inth')} />
				) : (
					<span class={tag.classes.wordmark} dir="ltr">
						<span class={tag.classes.mark} set:html={brandMarkSvg('c15t')} />
						<span class={tag.classes.label}>c15t</span>
					</span>
				)}
			</span>
		</a>
	)
}
