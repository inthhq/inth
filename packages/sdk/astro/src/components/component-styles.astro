---
import { isIABConfigured } from '@inth/sdk/runtime';
import {
	INLINE_IAB_STYLES_CSS,
	INLINE_IAB_STYLES_ID,
	INLINE_STYLES_CSS,
	INLINE_STYLES_ID,
	markStylesEmitted,
	privacyChoicesFirstPaintSheets,
	privacyChoicesPresentation,
} from '@inth/astro/server';

interface Props {
	/** The outer document's nonce when rendered through a server island. */
	nonce?: string;
	/**
	 * Emit even when the server decided no banner shows, as for a banner
	 * rendered with `force` or a cached page that renders it later.
	 */
	force?: boolean;
}

const { inth } = Astro.locals;
// A visitor the server shows no banner, such as one with a stored choice,
// gets no first-paint rules: the dialog, which builds on them, adds them
// when it opens. A page shared by every visitor (prerendered, or no policy
// yet) may still show one, and IAB sites keep both sheets.
const needed =
	Astro.props.force === true ||
	inth === undefined ||
	inth.shouldShowBanner ||
	inth.prerendered ||
	!inth.hasPolicy ||
	isIABConfigured(inth.options.iab);
const emit =
	inth?.options.inlineStyles === true &&
	needed &&
	markStylesEmitted(Astro.locals);
const nonce = Astro.props.nonce ?? inth?.nonce;
// A page whose banner renders the Privacy Choices design carries its
// shell and the one presentation it shows (Card, Banner or Drawer)
// instead of the classic banner's rules, as React's banner does.
const presentation =
	emit && inth
		? privacyChoicesPresentation(inth.snapshot, inth.options)
		: null;
const privacyChoicesSheets = presentation
	? privacyChoicesFirstPaintSheets(presentation)
	: [];
---

{
	emit && !presentation && (
		<style
			is:inline
			data-inth-styles={INLINE_STYLES_ID}
			nonce={nonce}
			set:html={INLINE_STYLES_CSS}
		/>
	)
}

{
	privacyChoicesSheets.map((sheet) => (
		<style
			is:inline
			data-inth-styles={sheet.id}
			nonce={nonce}
			set:html={sheet.css}
		/>
	))
}

{
	emit && isIABConfigured(inth?.options.iab) && (
		<style
			is:inline
			data-inth-styles={INLINE_IAB_STYLES_ID}
			nonce={nonce}
			set:html={INLINE_IAB_STYLES_CSS}
		/>
	)
}
