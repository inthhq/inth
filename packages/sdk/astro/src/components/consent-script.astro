---
/**
 * Inlines the server-resolved consent config for the browser.
 *
 * Put this in your layout's `<head>`. It hands the client boot script the
 * decision the server already made — consents, policy, translations — so
 * the page boots with no `/init` roundtrip and no banner flicker, and it
 * writes the colour-scheme class before the stylesheet paints, so a
 * system-dark visitor does not get a light banner for a frame.
 *
 * `<ConsentBanner />` renders both itself if they have not been emitted
 * yet, so a site with a banner in every layout does not need this
 * explicitly — but `<head>` is where the colour-scheme script belongs.
 */
import { THEME_STYLE_ELEMENT_ID } from '@inth/sdk/ui/theme';
import { applyExperimentTheme } from '@inth/sdk/engine';
import {
	buildColorSchemeScript,
	buildThemeCSS,
	buildConfigJSON,
	buildLocalsBootJSON,
	markConfigEmitted,
} from '@inth/astro/server';
import ComponentStyles from './component-styles.astro';

const { inth } = Astro.locals;
const shouldEmit = inth !== undefined && markConfigEmitted(Astro.locals);
const colorSchemeScript = shouldEmit
	? buildColorSchemeScript(inth.options.colorScheme)
	: '';
// An arm's theme overrides ride on the host theme, like its presentation.
const themeCSS = shouldEmit
	? buildThemeCSS(
			applyExperimentTheme(
				inth.options.theme,
				inth.options.experiment,
				inth.snapshot.experiment
			)
		)
	: '';
---

{
	colorSchemeScript && (
		<script
			is:inline
			data-inth-inline
			nonce={inth?.nonce}
			set:html={colorSchemeScript}
		/>
	)
}

<ComponentStyles />

{
	themeCSS && (
		<style
			is:inline
			id={THEME_STYLE_ELEMENT_ID}
			nonce={inth?.nonce}
			set:html={themeCSS}
		/>
	)
}

{
	shouldEmit && (
		<script
			is:inline
			type="application/json"
			data-inth-config
			nonce={inth.nonce}
			set:html={buildConfigJSON(inth.config)}
		/>
	)
}

{
	shouldEmit && (
		<script
			is:inline
			type="application/json"
			data-inth-boot
			nonce={inth.nonce}
			set:html={buildLocalsBootJSON(inth)}
		/>
	)
}
