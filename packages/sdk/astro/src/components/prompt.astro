---
/**
 * The consent prompt: a Card, Banner or Drawer, from the `container`,
 * `edgeStyle` and `blockUntilChoice` the integration's `presentation` and
 * the policy's `surface` resolve to.
 *
 * The server renders the collapsed prompt with zero framework JavaScript:
 * markup, copy, layout and the policy-driven button order, with the same
 * DOM shape and `data-testid`s as React's banner. The browser prompt (its
 * own chunk) takes it over once the engine runs: Customize and the options
 * it opens in place, the phone layout, the commit, blocking and focus.
 *
 * The server renders the prompt only when the decision it already resolved
 * says to, so a returning visitor gets no prompt markup at all — no client
 * bytes and no flash.
 *
 * A prerendered page is built once for every visitor. In offline mode the
 * prompt is rendered hidden. A small inline script shows it at first paint
 * to visitors with nothing stored, and the runtime decides for everyone
 * else once it has read their records. In hosted and manifest mode the
 * build cannot know the policy, so the browser renders the prompt from the
 * same model once its init resolves.
 *
 * Beside the config it leaves the snapshot it rendered from in a
 * `data-inth-boot` data block, which the page script reads so the client
 * answers before the engine loads.
 *
 * ```astro
 * ---
 * import ConsentBanner from '@inth/astro/components/consent-banner.astro';
 * ---
 * <ConsentBanner />
 * ```
 */
import { THEME_STYLE_ELEMENT_ID } from '@inth/sdk/ui/theme';
import { applyExperimentTheme } from '@inth/sdk/engine';
import {
	buildBannerRevealScript,
	buildColorSchemeScript,
	buildLocalsBootJSON,
	buildThemeCSS,
	buildConfigJSON,
	EARLY_CONSENT_TAP_SCRIPT,
	markConfigEmitted,
	PROMPT_SLOT_ATTRIBUTE,
	promptClassNames,
	renderPromptHTML,
	resolvePromptModel,
} from '@inth/astro/server';
import type { PromptProps } from '@inth/astro/server';
import ComponentStyles from './component-styles.astro';

interface Props extends PromptProps {
	/**
	 * Render even when the server decided the banner should stay hidden.
	 * Useful for visual testing.
	 */
	force?: boolean;
	/**
	 * Content Security Policy nonce for this banner's inline code.
	 * Defaults to `Astro.locals.inth.nonce`. `<ConsentBannerDeferred />`
	 * passes the page's nonce here: the island renders in a request of its
	 * own, whose nonce the page's policy does not list.
	 */
	nonce?: string;
	/** The deferred wrapper already renders the static CSS. @internal */
	inlineStyles?: boolean;
}

const {
	force = false,
	inlineStyles = true,
	nonce: nonceProp,
	...props
} = Astro.props;

const { inth } = Astro.locals;

if (!inth) {
	throw new Error(
		'@inth/astro: `Astro.locals.inth` is missing. The inth() integration registers the middleware that populates it — check it is listed in astro.config, and that you have not set `middleware: false`.'
	);
}

const { snapshot } = inth;
// An arm's theme overrides ride on the host theme: its tokens, its
// `consentActions` and its `slots` all follow the assignment.
const theme = applyExperimentTheme(
	inth.options.theme,
	inth.options.experiment,
	snapshot.experiment
);
// Rendered as a server island, this is a request of its own with its own
// nonce, but the page's policy is the one that judges the inserted markup.
const nonce = nonceProp ?? inth.nonce;
// No resolved policy means no consent surface, even when forced.
const shouldRender = inth.hasConsentUi && (force || inth.shouldShowBanner);
// A prerendered page is shared by every visitor, so it cannot know whether
// this one has already chosen. It ships hidden, and the browser shows it
// after reading the visitor's cookie.
const hidden = inth.prerendered && !force;
const emitConfig = markConfigEmitted(Astro.locals);
// A fallback for layouts with no <ConsentScript /> in <head>. It still runs
// before the banner markup it precedes, so the first paint is right.
const colorSchemeScript = emitConfig
	? buildColorSchemeScript(inth.options.colorScheme)
	: '';
const themeCSS = emitConfig
	? buildThemeCSS(theme)
	: '';

// The prompt in its Card, Banner or Drawer, rendered collapsed on the
// desktop layout as React's banner renders it; the browser takes it over
// from the spot below.
const model = inth.hasPolicy
	? resolvePromptModel({
			classNames: promptClassNames,
			hostname: Astro.url.hostname,
			options: {
				disableAnimation: inth.options.disableAnimation,
				experiment: inth.options.experiment,
				legalLinks: inth.options.legalLinks,
				presentation: inth.options.presentation,
				theme,
			},
			props,
			snapshot,
		})
	: null;
// Holds a tap on the server-rendered prompt until the prompt's chunk takes
// it over, which waits for the engine: the tap is replayed through the
// prompt's own handlers, so Customize opens the options in place and a
// choice commits through the prompt's plan. A server island is inserted
// after the page script ran, so it gets none, as does a prompt the page
// ships hidden to every visitor.
const earlyTaps =
	inlineStyles &&
	shouldRender &&
	model !== null &&
	!hidden &&
	inth.shouldShowBanner &&
	!inth.prerendered;
---

{
	emitConfig && colorSchemeScript && (
		<script
			is:inline
			data-inth-inline
			nonce={nonce}
			set:html={colorSchemeScript}
		/>
	)
}

{inlineStyles && <ComponentStyles force={shouldRender} nonce={nonce} />}

{
	themeCSS && (
		<style is:inline id={THEME_STYLE_ELEMENT_ID} nonce={nonce} set:html={themeCSS} />
	)
}

{
	emitConfig && (
		<script
			is:inline
			type="application/json"
			data-inth-config
			nonce={nonce}
			set:html={buildConfigJSON(inth.config)}
		/>
	)
}

{
	emitConfig && (
		<script
			is:inline
			type="application/json"
			data-inth-boot
			nonce={nonce}
			set:html={buildLocalsBootJSON(inth)}
		/>
	)
}

{
	earlyTaps && (
		<script
			is:inline
			data-inth-inline
			nonce={nonce}
			set:html={EARLY_CONSENT_TAP_SCRIPT}
		/>
	)
}

{
	/*
	 * The browser prompt takes over from this spot, reading its props and
	 * class names here. With no policy yet the server renders nothing, but
	 * the browser may still owe a prompt: a prerendered page in hosted or
	 * manifest mode only learns its policy from the visitor's own init, and
	 * so does a server render whose init failed. The browser then renders
	 * it here from the same model.
	 */
	<div
		hidden
		{...{
			[PROMPT_SLOT_ATTRIBUTE]: JSON.stringify({
				classNames: promptClassNames,
				props,
			}),
		}}
	/>
}

{
	shouldRender && model && (
		<Fragment set:html={renderPromptHTML(model, hidden)} />
	)
}

{
	/*
	 * Right after the hidden banner, so a visitor with nothing stored sees it
	 * in the first paint instead of after the module scripts load.
	 */
	shouldRender && hidden && (
		<script
			is:inline
			data-inth-inline
			nonce={nonce}
			set:html={buildBannerRevealScript(
				inth.options.storageConfig,
				'consent-banner'
			)}
		/>
	)
}

<script>
	// The banner's only client-side code: one delegated listener, shared by
	// every banner and dialog trigger on the site. Astro bundles and dedupes
	// this module across pages.
	import { attachBannerActions } from '@inth/astro/client';

	attachBannerActions();
</script>
