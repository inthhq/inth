---
/**
 * Server-rendered consent banner.
 *
 * The shell — markup, copy, layout, the policy-driven button order — is
 * produced on the server with zero framework JavaScript. Only one small
 * bundled script ships, and it is shared by every banner on the site: a
 * delegated click handler that turns `data-inth-action` into runtime calls.
 *
 * The server renders the banner only when the decision it already resolved
 * says to, so a returning visitor gets no banner markup at all — no client
 * bytes and no flash. The same DOM shape and the same `data-testid`s as the
 * Svelte and React banners, so cross-framework tests and CSS both hold.
 *
 * A prerendered page is built once for every visitor. In offline mode the
 * banner is rendered hidden. A small inline script shows it at first paint
 * to visitors with nothing stored, and the runtime decides for everyone
 * else once it has read their records. In hosted and manifest mode the build cannot know the
 * policy, so the browser renders the banner from the same model once its
 * init resolves.
 *
 * Beside the config it leaves the snapshot it rendered from in a
 * `data-inth-boot` data block. The page script reads it and, for a visitor
 * who still has to choose, loads the consent engine after the page; an
 * inline script ahead of the markup then records a tap that lands before
 * the page script runs.
 *
 * ```astro
 * ---
 * import ConsentBanner from '@inth/astro/components/consent-banner.astro';
 * ---
 * <ConsentBanner />
 * ```
 */
import { THEME_STYLE_ELEMENT_ID } from '@inth/sdk/ui/theme';
import { cppaOptOutIconSvg } from '@inth/sdk/ui/utils/opt-out-icon';
import { SURFACE_ROOT_ATTRIBUTE } from '@inth/sdk/runtime/page-globals';
import { applyExperimentAssignment, applyExperimentTheme } from '@inth/sdk/engine';
import {
	buildBannerRevealScript,
	buildColorSchemeScript,
	buildLocalsBootJSON,
	buildThemeCSS,
	buildConfigJSON,
	canDeferEngine,
	EARLY_CONSENT_TAP_SCRIPT,
	markConfigEmitted,
	PROMPT_SLOT_ATTRIBUTE,
	promptClassNames,
	resolvePromptModel,
} from '@inth/astro/server';
import type { PromptProps } from '@inth/astro/server';
import Branding from './branding.astro';
import ComponentStyles from './component-styles.astro';

interface Props extends PromptProps {
	/**
	 * Render even when the server decided the banner should stay hidden.
	 * Useful for visual testing.
	 */
	force?: boolean;
	/**
	 * Content Security Policy nonce for this banner's inline code.
	 * Defaults to `Astro.locals.inth.nonce`. `<ConsentBannerDeferred />`
	 * passes the page's nonce here: the island renders in a request of its
	 * own, whose nonce the page's policy does not list.
	 */
	nonce?: string;
	/** The deferred wrapper already renders the static CSS. @internal */
	inlineStyles?: boolean;
}

const {
	force = false,
	inlineStyles = true,
	nonce: nonceProp,
	...props
} = Astro.props;

const { inth } = Astro.locals;

if (!inth) {
	throw new Error(
		'@inth/astro: `Astro.locals.inth` is missing. The inth() integration registers the middleware that populates it — check it is listed in astro.config, and that you have not set `middleware: false`.'
	);
}

const { snapshot } = inth;
// An arm's theme overrides ride on the host theme: its tokens, its
// `consentActions` and its `slots` all follow the assignment.
const theme = applyExperimentTheme(
	inth.options.theme,
	inth.options.experiment,
	snapshot.experiment
);
// Rendered as a server island, this is a request of its own with its own
// nonce, but the page's policy is the one that judges the inserted markup.
const nonce = nonceProp ?? inth.nonce;
// No resolved policy means no consent surface, even when forced.
const shouldRender = inth.hasConsentUi && (force || inth.shouldShowBanner);
// A prerendered page is shared by every visitor, so it cannot know whether
// this one has already chosen. It ships hidden, and the browser shows it
// after reading the visitor's cookie.
const hidden = inth.prerendered && !force;
const emitConfig = markConfigEmitted(Astro.locals);
// A fallback for layouts with no <ConsentScript /> in <head>. It still runs
// before the banner markup it precedes, so the first paint is right.
const colorSchemeScript = emitConfig
	? buildColorSchemeScript(inth.options.colorScheme)
	: '';
const themeCSS = emitConfig
	? buildThemeCSS(theme)
	: '';

const model = resolvePromptModel({
	classNames: promptClassNames,
	disableAnimation: inth.options.disableAnimation,
	legalLinks: inth.options.legalLinks,
	// The arm is the host-resolved `variant`, already on the server snapshot.
	presentation: applyExperimentAssignment(
		inth.options.presentation,
		inth.options.experiment,
		snapshot.experiment
	),
	props,
	snapshot,
	theme,
});
// Records a tap that lands before the page script runs, for a banner whose
// engine may load after the page. A server island is inserted after the
// page script ran, and the script would then hold the banner's clicks with
// nothing to release them, so it gets none.
const earlyTaps =
	inlineStyles &&
	shouldRender &&
	!hidden &&
	inth.shouldShowBanner &&
	!inth.prerendered &&
	canDeferEngine(
		snapshot,
		inth.options,
		model.blocking,
		Date.now(),
		inth.config
	);
---

{
	emitConfig && colorSchemeScript && (
		<script
			is:inline
			data-inth-inline
			nonce={nonce}
			set:html={colorSchemeScript}
		/>
	)
}

{inlineStyles && <ComponentStyles force={shouldRender} nonce={nonce} />}

{
	themeCSS && (
		<style is:inline id={THEME_STYLE_ELEMENT_ID} nonce={nonce} set:html={themeCSS} />
	)
}

{
	emitConfig && (
		<script
			is:inline
			type="application/json"
			data-inth-config
			nonce={nonce}
			set:html={buildConfigJSON(inth.config)}
		/>
	)
}

{
	emitConfig && (
		<script
			is:inline
			type="application/json"
			data-inth-boot
			nonce={nonce}
			set:html={buildLocalsBootJSON(inth)}
		/>
	)
}

{
	earlyTaps && (
		<script
			is:inline
			data-inth-inline
			nonce={nonce}
			set:html={EARLY_CONSENT_TAP_SCRIPT}
		/>
	)
}

{
	/*
	 * No policy yet, so nothing to render, but the browser may still owe a
	 * banner: a prerendered page in hosted or manifest mode only learns its
	 * policy from the visitor's own init, and so does a server render whose
	 * init failed. The browser renders it into this spot from the same
	 * model, with the same props and class names.
	 */
	!inth.hasPolicy && (
		<div
			hidden
			{...{
				[PROMPT_SLOT_ATTRIBUTE]: JSON.stringify({
					classNames: promptClassNames,
					props,
				}),
			}}
		/>
	)
}

{
	shouldRender && model.blocking && (
		<div
			aria-hidden="true"
			class={model.classes.overlay}
			style={model.styles.overlay}
			data-testid="consent-banner-overlay"
			hidden={hidden ? true : undefined}
		/>
	)
}

{
	shouldRender && (
		<div
			class={model.classes.root}
			style={model.styles.root}
			data-blocking={model.blocking ? 'true' : undefined}
			data-inth-visible={hidden ? 'false' : 'true'}
			data-model={model.model}
			data-position={model.position}
			data-prompt={model.prompt}
			data-testid="consent-banner-root"
			{...{ [SURFACE_ROOT_ATTRIBUTE]: 'banner' }}
			data-variant={model.variant}
			dir={model.textDirection}
			hidden={hidden ? true : undefined}
			lang={model.language}
		>
			<div class={model.classes.cardShell}>
				<Branding
					branding={snapshot.branding}
					hide={props.hideBranding}
					hostname={Astro.url.hostname}
					noStyle={props.noStyle}
					securedBy={model.copy.securedBy}
					surface="banner"
					theme={theme}
				/>
				<div
					aria-label={model.copy.title}
					aria-modal={model.blocking ? "true" : undefined}
					class={model.classes.card}
					style={model.styles.card}
					data-testid="consent-banner-card"
					role={model.blocking ? "dialog" : "region"}
					tabindex="-1"
				>
					<div
						class={model.classes.header}
						style={model.styles.header}
						data-testid="consent-banner-header"
					>
						<h2
							class={model.classes.title}
							style={model.styles.title}
							data-testid="consent-banner-title"
						>
							{model.copy.title}
						</h2>
						<div
							class={model.classes.description}
							style={model.styles.description}
							data-context="banner"
							data-testid="consent-banner-description"
						>
							{model.copy.description}
							{
								/*
								 * The React banner's `InlineLegalLinks` shape: a space
								 * first, and a comma inside every link but the last,
								 * followed by a space outside it.
								 */
								model.legalLinks.length > 0 && (
									<span>{' '}{model.legalLinks.map((link) => (
										<span><a
											class={model.classes.legalLink || undefined}
											data-testid={`consent-banner-legal-link-${link.key}`}
											href={link.href}
											rel={link.rel}
											target={link.target}
										>{link.label}{link.separated ? ',' : ''}</a>{link.separated ? ' ' : ''}</span>
									))}</span>
								)
							}
						</div>
					</div>
					<div
						class={model.classes.footer}
						style={model.styles.footer}
						data-direction={model.direction}
						data-fill={model.shouldFill ? 'true' : undefined}
						data-split={model.split ? 'true' : undefined}
						data-testid="consent-banner-footer"
					>
						{model.rights.length > 0 && (
							<div
								class={model.classes.rights}
								style={model.styles.rights}
								data-testid="consent-banner-rights"
							>
								{model.rights.map(({ action, label, optOutVariant, right, showOptOutIcon }) => (
									<button
										class={model.classes.rightLink}
										style={model.styles.rightLink}
										data-action="right"
										data-inth-action={action}
										data-inth-rights={model.policyRights}
										data-opt-out-variant={optOutVariant}
										data-right={right}
										data-testid={`consent-banner-right-link-${right}`}
										type="button"
									>
										{showOptOutIcon && (
											<Fragment
												set:html={cppaOptOutIconSvg(
													model.classes.optOutIcon || undefined
												)}
											/>
										)}
										{label}
									</button>
								))}
							</div>
						)}
						{model.actionGroups.map((group) => (
							<div
								class={model.classes.actionGroup}
								style={model.styles.actionGroup}
								data-direction={model.direction}
								data-fill={model.shouldFill ? 'true' : undefined}
								data-testid="consent-banner-footer-sub-group"
							>
								{group.map(({ action, className, label, mode, style, variant }) => (
									<button
										class={className}
										style={style}
										data-action={action}
										data-inth-action={action}
										data-mode={mode}
										data-size={props.noStyle ? undefined : 'small'}
										data-testid={`consent-banner-${action}-button`}
										data-variant={variant}
										type="button"
									>
										{label}
									</button>
								))}
							</div>
						))}
					</div>
				</div>
			</div>
		</div>
	)
}

{
	/*
	 * Right after the hidden banner, so a visitor with nothing stored sees it
	 * in the first paint instead of after the module scripts load.
	 */
	shouldRender && hidden && (
		<script
			is:inline
			data-inth-inline
			nonce={nonce}
			set:html={buildBannerRevealScript(
				inth.options.storageConfig,
				'consent-banner'
			)}
		/>
	)
}

<script>
	// The banner's only client-side code: one delegated listener, shared by
	// every banner and dialog trigger on the site. Astro bundles and dedupes
	// this module across pages.
	import { attachBannerActions } from '@inth/astro/client';

	attachBannerActions();
</script>
