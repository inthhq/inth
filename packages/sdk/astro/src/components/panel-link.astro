---
/**
 * `<ConsentDialogLink>`: the "Privacy settings" control that opens a
 * consent dialog, for the footer every site needs.
 *
 * Ships no JavaScript of its own — it carries `data-inth-action` and the
 * one delegated listener the banner already installed picks it up.
 *
 * ```astro
 * <ConsentDialogLink>Privacy settings</ConsentDialogLink>
 * <ConsentDialogLink kind="iab">Ad partners</ConsentDialogLink>
 * ```
 */
import { applyExperimentAssignment, resolveOptOutLink } from '@inth/sdk/engine';
import { cppaOptOutIconSvg } from '@inth/sdk/ui/utils/opt-out-icon';
import { promptClassNames } from '@inth/astro/server';
import ComponentStyles from './component-styles.astro';

interface Props {
	/** Which dialog to open. */
	kind?: 'preferences' | 'iab';
	/**
	 * Which visitor right this link fulfills. Pass `'opt-out'` to record an
	 * opt-out in one click and open the confirmation view under an opt-out
	 * rule, falling back to the preference dialog under other models.
	 */
	right?: 'opt-out' | 'preferences';
	/** Extra class names. */
	class?: string;
	/** Render an `<a href="#">` instead of a `<button>`. */
	as?: 'button' | 'a';
	/** Ship the DOM without the bundled stylesheet's class names. */
	noStyle?: boolean;
}

const {
	kind = 'preferences',
	right,
	class: className,
	as = 'button',
	noStyle = false,
} = Astro.props;
const Tag = as;
const { inth } = Astro.locals;
// Hidden until a resolved rule owes consent UI: nothing to manage before a
// rule resolves, and nothing owed under a `none` rule with no rights. The
// browser client toggles `hidden` as the snapshot changes.
const hasConsentUi = inth?.hasConsentUi ?? true;
const isOptOut = right === 'opt-out';
const presentation = inth
	? applyExperimentAssignment(
			inth.options.presentation,
			inth.options.experiment,
			inth.snapshot.experiment
		)
	: undefined;
const optOutLink = isOptOut
	? resolveOptOutLink(
			inth?.snapshot.translations?.translations,
			presentation?.optOutLink
		)
	: null;
const showOptOutIcon = optOutLink?.variant === 'privacy-choices';
const optOutIconClass = noStyle ? undefined : promptClassNames.banner.optOutIcon;
---

<ComponentStyles />

<Tag
	class={className}
	data-inth-action={isOptOut ? 'opt-out' : 'customize'}
	data-inth-dialog={kind}
	data-inth-surface="trigger"
	data-opt-out-variant={optOutLink?.variant}
	data-right={isOptOut ? 'opt-out' : undefined}
	data-testid="consent-dialog-trigger"
	hidden={hasConsentUi ? undefined : true}
	href={as === 'a' ? '#inth-preferences' : undefined}
	type={as === 'button' ? 'button' : undefined}
>
	{showOptOutIcon && <Fragment set:html={cppaOptOutIconSvg(optOutIconClass)} />}
	<slot>{optOutLink ? optOutLink.label : ''}</slot>
</Tag>

<script>
	import { attachBannerActions } from '@inth/astro/client';

	attachBannerActions();
</script>
