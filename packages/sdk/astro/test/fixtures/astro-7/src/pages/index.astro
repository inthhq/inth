---
import ConsentBanner from '@inth/astro/components/consent-banner.astro';
import ConsentDialog from '@inth/astro/components/consent-dialog.astro';
import ConsentScript from '@inth/astro/components/consent-script.astro';
import IABConsentBanner from '@inth/astro/components/iab-consent-banner.astro';
import IABConsentDialog from '@inth/astro/components/iab-consent-dialog.astro';

const iab = Astro.locals.inth?.snapshot.model === 'iab';
---
<html lang="en">
	<head><meta charset="utf-8" /><title>Fixture</title><ConsentScript /></head>
	<body>
		<h1>Fixture</h1>
		{ iab ? <IABConsentBanner force /> : <ConsentBanner /> }
		{ iab ? <IABConsentDialog /> : <ConsentDialog /> }
	</body>
</html>
