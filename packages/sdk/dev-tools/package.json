{
  "name": "@inth/sdk-dev-tools",
  "version": "0.0.0-alpha.0",
  "private": true,
  "description": "Developer tools for debugging Inth. Inspect consent state, resolved policy, location, IAB TCF state and kernel events.",
  "keywords": [
    "cmp",
    "consent",
    "cookie-consent",
    "debugging",
    "developer-tools",
    "devtools",
    "gdpr",
    "inth",
    "privacy"
  ],
  "homepage": "https://inth.com",
  "bugs": {
    "url": "https://github.com/inthhq/inth/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inthhq/inth.git",
    "directory": "packages/sdk/dev-tools"
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rslib build && node ../../../scripts/normalize-dist-types.mjs",
    "check-types": "tsc --noEmit",
    "dev": "sh -c 'rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
    "fmt": "oxfmt -c ../../../oxfmt.sdk.config.ts .",
    "lint": "oxlint -c ../../../oxlint.sdk.config.ts ./src",
    "test": "vitest run"
  },
  "dependencies": {
    "@inth/sdk-core": "workspace:*",
    "@inth/sdk-schema": "workspace:*"
  },
  "devDependencies": {
    "@inth/typescript-config": "workspace:*",
    "@rslib/core": "0.23.2",
    "@types/node": "25.5.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "jsdom": "^25.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "postcss": "^8.5.16",
    "typescript": "7.0.2",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}
