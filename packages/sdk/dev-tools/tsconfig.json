{
	"extends": "@inth/typescript-config/base.json",
	"compilerOptions": {
		"rootDir": "src",
		"lib": ["dom", "esnext"],
		"paths": {
			"@inth/sdk-core": ["../core/dist-types/index.d.ts"],
			"@inth/sdk-core/*": ["../core/dist-types/*"],
			"@inth/sdk-schema/types": ["../schema/dist-types/types.d.ts"],
			"~/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": [
		"node_modules",
		"dist",
		"src/**/__tests__/**",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.ts",
		"src/**/*.spec.tsx"
	]
}
