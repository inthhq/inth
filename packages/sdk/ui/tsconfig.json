{
	"extends": "@c15t/typescript-config/base.json",
	"compilerOptions": {
		"rootDir": "src",
		"moduleResolution": "bundler",
		"paths": {
			"@inth/sdk-translations": ["../translations/dist-types/index.d.ts"],
			"@inth/sdk-translations/*": ["../translations/dist-types/*"],
			"@inth/sdk-core": ["../core/dist-types/index.d.ts"],
			"@inth/sdk-core/*": ["../core/dist-types/*"],
			"~/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
