{
	"extends": "@c15t/typescript-config/react-library.json",
	"compilerOptions": {
		"rootDir": "src",
		"lib": ["dom", "esnext"],
		"types": ["node"],
		"paths": {
			"@inth/sdk-schema": ["../schema/dist-types/index.d.ts"],
			"@inth/sdk-schema/canonical-order": [
				"../schema/dist-types/shared/canonical-order.d.ts"
			],
			"@inth/sdk-schema/*": ["../schema/dist-types/*"],
			"@inth/sdk-translations": ["../translations/dist-types/index.d.ts"],
			"@inth/sdk-translations/*": ["../translations/dist-types/*"],
			"~/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": [
		"node_modules",
		"**/__tests__/**",
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/*.spec.ts",
		"**/*.spec.tsx",
		"**/*.browser.test.ts"
	]
}
