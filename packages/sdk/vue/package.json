{
	"name": "@inth/vue",
	"version": "0.0.0-alpha.0",
	"description": "Vue cookie consent banner, consent dialog and preference center for Inth. Nuxt apps use @inth/nuxt.",
	"keywords": [
		"banner",
		"ccpa",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management-platform",
		"consent-manager",
		"consent-mode-v2",
		"cookie",
		"cookie-banner",
		"cookie-consent",
		"gdpr",
		"global-privacy-control",
		"google-consent-mode",
		"headless",
		"iab-tcf",
		"lgpd",
		"preference-center",
		"privacy",
		"privacy-compliance",
		"typescript",
		"user-consent",
		"vue",
		"vue-cookie-consent",
		"web-privacy"
	],
	"homepage": "https://inth.com",
	"bugs": {
		"url": "https://github.com/inthhq/inth/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/inthhq/inth.git",
		"directory": "packages/sdk/vue"
	},
	"files": [
		"dist",
		"docs",
		"AGENTS.md",
		"SKILL.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"**/*.vue",
		"./dist/translations/*.js"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.mts"
			],
			"vite": [
				"./dist/vite.d.mts"
			],
			"vue-plugin": [
				"./dist/index.d.mts"
			],
			"devtools": [
				"./dist/devtools.d.mts"
			]
		}
	},
	"imports": {
		"#inth/composables": {
			"types": "./dist/runtime/composables/index.d.ts",
			"default": "./dist/runtime/composables/index.js"
		},
		"#imports": {
			"types": "./dist/runtime/vue/stubs.d.ts",
			"default": "./dist/runtime/vue/stubs.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"import": "./dist/testing.mjs",
			"default": "./dist/testing.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"import": "./dist/vite.mjs",
			"default": "./dist/vite.mjs"
		},
		"./vue-plugin": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./devtools": {
			"types": "./dist/devtools.d.mts",
			"import": "./dist/devtools.mjs",
			"default": "./dist/devtools.mjs"
		},
		"./nuxt": {
			"types": "./dist/nuxt.d.mts",
			"import": "./dist/nuxt.mjs",
			"default": "./dist/nuxt.mjs"
		},
		"./runtime/*": "./dist/runtime/*",
		"./composables/*": "./dist/runtime/composables/*",
		"./runtime/components/consent-banner.vue": {
			"types": "./dist/runtime/components/prompt.d.vue.ts",
			"import": "./dist/runtime/components/prompt.vue",
			"default": "./dist/runtime/components/prompt.vue"
		},
		"./runtime/components/consent-dialog-trigger.vue": {
			"types": "./dist/runtime/components/panel-trigger.d.vue.ts",
			"import": "./dist/runtime/components/panel-trigger.vue",
			"default": "./dist/runtime/components/panel-trigger.vue"
		},
		"./runtime/components/consent-manager.vue": {
			"types": "./dist/runtime/components/manager.d.vue.ts",
			"import": "./dist/runtime/components/manager.vue",
			"default": "./dist/runtime/components/manager.vue"
		},
		"./runtime/components/consent-widget-manager-context.js": {
			"types": "./dist/runtime/components/preferences-manager-context.d.ts",
			"import": "./dist/runtime/components/preferences-manager-context.js",
			"default": "./dist/runtime/components/preferences-manager-context.js"
		},
		"./runtime/components/consent-widget.vue": {
			"types": "./dist/runtime/components/preferences.d.vue.ts",
			"import": "./dist/runtime/components/preferences.vue",
			"default": "./dist/runtime/components/preferences.vue"
		},
		"./runtime/components/iab-consent-banner.vue": {
			"types": "./dist/runtime/components/iab-prompt.d.vue.ts",
			"import": "./dist/runtime/components/iab-prompt.vue",
			"default": "./dist/runtime/components/iab-prompt.vue"
		},
		"./runtime/components/iab-consent-dialog.vue": {
			"types": "./dist/runtime/components/iab-panel.d.vue.ts",
			"import": "./dist/runtime/components/iab-panel.vue",
			"default": "./dist/runtime/components/iab-panel.vue"
		},
		"./runtime/components/consent-branding-icon.vue": {
			"types": "./dist/runtime/components/branding-icon.d.vue.ts",
			"import": "./dist/runtime/components/branding-icon.vue",
			"default": "./dist/runtime/components/branding-icon.vue"
		},
		"./runtime/components/consent-dialog-link.vue": {
			"types": "./dist/runtime/components/consent-dialog-link.d.vue.ts",
			"import": "./dist/runtime/components/consent-dialog-link.vue",
			"default": "./dist/runtime/components/consent-dialog-link.vue"
		},
		"./runtime/components/consent-button.vue": {
			"types": "./dist/runtime/components/button.d.vue.ts",
			"import": "./dist/runtime/components/button.vue",
			"default": "./dist/runtime/components/button.vue"
		},
		"./runtime/components/consent-tag.vue": {
			"types": "./dist/runtime/components/tag.d.vue.ts",
			"import": "./dist/runtime/components/tag.vue",
			"default": "./dist/runtime/components/tag.vue"
		},
		"./runtime/components/consent-actions.vue": {
			"types": "./dist/runtime/components/actions.d.vue.ts",
			"import": "./dist/runtime/components/actions.vue",
			"default": "./dist/runtime/components/actions.vue"
		},
		"./runtime/components/consent-switch.vue": {
			"types": "./dist/runtime/components/switch.d.vue.ts",
			"import": "./dist/runtime/components/switch.vue",
			"default": "./dist/runtime/components/switch.vue"
		},
		"./runtime/components/consent-link.vue": {
			"types": "./dist/runtime/components/link.d.vue.ts",
			"import": "./dist/runtime/components/link.vue",
			"default": "./dist/runtime/components/link.vue"
		},
		"./runtime/components/consent-description.vue": {
			"types": "./dist/runtime/components/description.d.vue.ts",
			"import": "./dist/runtime/components/description.vue",
			"default": "./dist/runtime/components/description.vue"
		},
		"./runtime/components/consent-gate.vue": {
			"types": "./dist/runtime/components/consent-gate.d.vue.ts",
			"import": "./dist/runtime/components/consent-gate.vue",
			"default": "./dist/runtime/components/consent-gate.vue"
		},
		"./runtime/components/consent-legal-links.vue": {
			"types": "./dist/runtime/components/legal-links.d.vue.ts",
			"import": "./dist/runtime/components/legal-links.vue",
			"default": "./dist/runtime/components/legal-links.vue"
		},
		"./runtime/components/inth-provider.vue": {
			"types": "./dist/runtime/components/inth-provider.d.vue.ts",
			"import": "./dist/runtime/components/inth-provider.vue",
			"default": "./dist/runtime/components/inth-provider.vue"
		},
		"./runtime/components/nuxt-inth-provider.vue": {
			"types": "./dist/runtime/components/nuxt-inth-provider.d.vue.ts",
			"import": "./dist/runtime/components/nuxt-inth-provider.vue",
			"default": "./dist/runtime/components/nuxt-inth-provider.vue"
		},
		"./postcss-tailwind3": {
			"types": "./dist/postcss-tailwind3.d.mts",
			"import": "./dist/postcss-tailwind3.mjs",
			"default": "./dist/postcss-tailwind3.mjs"
		},
		"./gpp": {
			"types": "./dist/gpp.d.mts",
			"import": "./dist/gpp.mjs",
			"default": "./dist/gpp.mjs"
		},
		"./engine": {
			"types": "./dist/engine.d.mts",
			"import": "./dist/engine.mjs",
			"default": "./dist/engine.mjs"
		},
		"./translations/*": {
			"types": "./dist/translations/*.d.ts",
			"import": "./dist/translations/*.js",
			"default": "./dist/translations/*.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"tag": "alpha"
	},
	"scripts": {
		"build": "unbuild",
		"build:docs": "bun ../../../scripts/generate-package-docs.ts @inth/vue",
		"check-types": "vue-tsc -p tsconfig.vue.json --noEmit",
		"prepack": "pnpm run build:docs && pnpm run build",
		"test": "vitest run"
	},
	"dependencies": {
		"@inth/sdk": "workspace:*",
		"defu": "^6.1.4",
		"ufo": "^1.6.1"
	},
	"devDependencies": {
		"@inth/typescript-config": "workspace:*",
		"@inth/vitest-config": "workspace:*",
		"@nuxt/module-builder": "^1.0.2",
		"@rsbuild/core": "1.7.5",
		"@types/node": "25.5.0",
		"@vitejs/plugin-vue": "6.0.7",
		"@vitest/coverage-istanbul": "4.1.10",
		"@vue/runtime-core": "3.5.43",
		"@vue/test-utils": "^2.4.6",
		"h3": "1.15.11",
		"jsdom": "^25.0.0",
		"nitropack": "2.13.4",
		"nuxt": "^4.5.1",
		"pathe": "^2.0.3",
		"typescript": "6.0.3",
		"unbuild": "^3.6.1",
		"vite": "8.1.3",
		"vitest": "4.1.10",
		"vue": "^3.5.39",
		"vue-tsc": "^3.3.3"
	},
	"peerDependencies": {
		"nuxt": "^3.0.0 || ^4.0.0",
		"vue": "^3.5.39 || ^3.6.0-0"
	},
	"peerDependenciesMeta": {
		"nuxt": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"nuxt": "./dist/module.mjs"
}
