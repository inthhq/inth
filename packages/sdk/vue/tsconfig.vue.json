{
	"extends": "@inth/typescript-config/base.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"paths": {
			"#imports": ["./src/runtime/vue/stubs.ts"],
			"#inth/composables": ["./src/runtime/composables/index.ts"],
			"@inth/conformance": ["../../../internals/conformance/src/index.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.vue",
		"src/**/*.d.ts",
		"src/env.d.ts",
		"src/inth-aliases.d.ts"
	],
	"exclude": ["src/**/*.nuxt.ts", "src/runtime/plugin.nuxt.ts"]
}
