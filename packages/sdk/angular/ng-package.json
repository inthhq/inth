{
	"$schema": "./node_modules/ng-packagr/ng-package.schema.json",
	"dest": "dist",
	"assets": [
		{
			"glob": "styles.css",
			"input": "src",
			"output": "."
		},
		{
			"glob": "styles.css",
			"input": "src/iab",
			"output": "iab"
		},
		{
			"glob": "index.{mjs,d.ts}",
			"input": "postcss-tailwind3",
			"output": "postcss-tailwind3"
		}
	],
	"lib": {
		"entryFile": "src/public-api.ts"
	},
	"allowedNonPeerDependencies": [
		"@c15t/core",
		"@c15t/dev-tools",
		"@c15t/iab",
		"@c15t/schema",
		"@c15t/translations",
		"@c15t/ui",
		"tslib"
	]
}
