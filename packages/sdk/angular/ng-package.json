{
	"$schema": "./node_modules/ng-packagr/ng-package.schema.json",
	"dest": "dist",
	"assets": [
		{
			"glob": "styles.css",
			"input": "src",
			"output": "."
		},
		{
			"glob": "styles.css",
			"input": "src/iab",
			"output": "iab"
		},
		{
			"glob": "index.{mjs,d.ts}",
			"input": "postcss-tailwind3",
			"output": "postcss-tailwind3"
		}
	],
	"lib": {
		"entryFile": "src/public-api.ts"
	},
	"allowedNonPeerDependencies": ["@inth/sdk", "tslib"]
}
