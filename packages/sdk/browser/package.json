{
	"name": "@inth/sdk-browser",
	"version": "3.2.0-canary.0",
	"private": true,
	"description": "Script-tag build of c15t for Webflow, WordPress, Framer, Squarespace and plain HTML. One script tag, script blocking and an optional IAB TCF build.",
	"keywords": [
		"banner",
		"c15t",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management",
		"consent-management-platform",
		"consent-manager",
		"cookie",
		"cookie-banner",
		"cookie-consent",
		"framer",
		"gdpr",
		"global-privacy-control",
		"headless",
		"iab-tcf",
		"javascript",
		"no-build",
		"privacy",
		"script-blocking",
		"script-tag",
		"squarespace",
		"vanilla-js",
		"webflow",
		"wordpress"
	],
	"homepage": "https://c15t.com/docs/frameworks/html/quickstart",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/sdk/browser"
	},
	"files": [
		"dist",
		"dist-types",
		"AGENTS.md",
		"SKILL.md",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"sideEffects": [
		"./dist/c15t.js",
		"./dist/c15t.hosted.js",
		"./dist/c15t.commit.js",
		"./dist/c15t.records.js",
		"./dist/c15t.dialog.js",
		"./dist/c15t.local.js",
		"./dist/c15t.offline.js",
		"./dist/c15t.iab.js",
		"./dist/c15t.headless.js",
		"./dist/c15t.devtools.js",
		"./dist/c15t.gpp.js",
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"unpkg": "./dist/c15t.js",
	"jsdelivr": "./dist/c15t.js",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./hosted": {
			"types": "./dist-types/hosted.d.ts",
			"import": "./dist/hosted.js",
			"default": "./dist/hosted.js"
		},
		"./testing": {
			"types": "./dist-types/testing.d.ts",
			"import": "./dist/testing.js",
			"default": "./dist/testing.js"
		},
		"./headless": {
			"types": "./dist-types/headless.d.ts",
			"import": "./dist/headless.js",
			"default": "./dist/headless.js"
		},
		"./devtools": {
			"types": "./dist-types/devtools.d.ts",
			"import": "./dist/devtools.js",
			"default": "./dist/devtools.js"
		},
		"./gpp": {
			"types": "./dist-types/gpp.d.ts",
			"import": "./dist/gpp.js",
			"default": "./dist/gpp.js"
		},
		"./styles.css": "./dist/c15t.css",
		"./c15t.js": "./dist/c15t.js",
		"./c15t.hosted.js": "./dist/c15t.hosted.js",
		"./c15t.commit.js": "./dist/c15t.commit.js",
		"./c15t.records.js": "./dist/c15t.records.js",
		"./c15t.dialog.js": "./dist/c15t.dialog.js",
		"./c15t.testing.js": "./dist/c15t.testing.js",
		"./c15t.headless.js": "./dist/c15t.headless.js",
		"./c15t.devtools.js": "./dist/c15t.devtools.js",
		"./c15t.gpp.js": "./dist/c15t.gpp.js",
		"./iab": {
			"types": "./dist-types/iab.d.ts",
			"import": "./dist/iab.js",
			"default": "./dist/iab.js"
		},
		"./c15t.iab.js": "./dist/c15t.iab.js",
		"./iab/styles.css": "./dist/c15t.iab.css",
		"./postcss-tailwind3": {
			"types": "./dist-types/postcss-tailwind3.d.ts",
			"import": "./dist/postcss-tailwind3.js",
			"default": "./dist/postcss-tailwind3.js"
		},
		"./prefetch": {
			"types": "./dist-types/prefetch.d.ts",
			"import": "./dist/prefetch.js",
			"default": "./dist/prefetch.js"
		}
	},
	"scripts": {
		"build": "pnpm run prebuild && rslib build && bun scripts/copy-styles.ts && node ../../../scripts/normalize-dist-types.mjs",
		"check-types": "pnpm run prebuild && tsc --noEmit",
		"dev": "sh -c 'pnpm run prebuild && rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "oxfmt -c ../../../oxfmt.sdk.config.ts .",
		"lint": "oxlint -c ../../../oxlint.sdk.config.ts ./src",
		"prebuild": "genversion --esm --semi src/version.ts && bun scripts/build-styles.ts",
		"test": "pnpm run prebuild && vitest run",
		"test:watch": "pnpm run prebuild && vitest"
	},
	"dependencies": {
		"@inth/sdk-core": "workspace:*",
		"@inth/sdk-dev-tools": "workspace:*",
		"@inth/sdk-iab": "workspace:*",
		"@inth/sdk-schema": "workspace:*",
		"@inth/sdk-translations": "workspace:*",
		"@inth/sdk-ui": "workspace:*"
	},
	"devDependencies": {
		"@c15t/conformance": "workspace:*",
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@emotion/css": "11.13.5",
		"@rslib/core": "0.23.2",
		"@types/node": "25.5.0",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-istanbul": "4.1.10",
		"esbuild": "^0.28.1",
		"genversion": "3.2.0",
		"jsdom": "^25.0.0",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"postcss": "8.5.10",
		"typescript": "7.0.2",
		"vite": "8.1.3",
		"vitest": "4.1.10"
	},
	"browserslist": [
		">0.5%",
		"last 2 versions",
		"not dead",
		"not op_mini all"
	]
}
