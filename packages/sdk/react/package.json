{
	"name": "@inth/react",
	"version": "3.2.0-canary.0",
	"description": "React cookie consent banner and React consent dialog for inth, plus a React cookie banner, preference center and headless hooks.",
	"keywords": [
		"cmp",
		"consent",
		"consent-manager",
		"cookie-banner",
		"cookie-consent",
		"gdpr",
		"headless",
		"iab-tcf",
		"react",
		"react-cookie-banner",
		"react-cookie-consent"
	],
	"homepage": "https://c15t.com/docs/frameworks/react/quickstart",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/sdk/react"
	},
	"files": [
		"dist",
		"dist-types",
		"AGENTS.md",
		"SKILL.md",
		"docs",
		"styles.css",
		"styles.tw3.css",
		"iab",
