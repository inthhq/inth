		"#consent-banner": {
			"types": "./dist-types/components/prompt/index.d.ts",
			"default": "./dist/components/prompt/index.js"
		},
		"#consent-provider": {
			"types": "./dist-types/provider.d.ts",
			"browser": "./dist/deferred/client-provider.js",
			"default": "./dist/provider.js"
		}
	},
