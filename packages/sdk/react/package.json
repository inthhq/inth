	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm run prebuild && rslib build && node ../../../scripts/normalize-dist-types.mjs && bun scripts/generate-distribution-css.ts && pnpm run clean:dist:test-artifacts && node ../shared/restore-client-directives.mjs src dist && node ../shared/write-translation-entries.mjs dist dist-types",
		"build:docs": "bun ../../../scripts/generate-package-docs.ts @inth/react",
		"check-types": "pnpm run prebuild && tsc --noEmit && tsc -p tsconfig.type-tests.json",
		"clean:dist:test-artifacts": "bun --eval \"import { rmSync } from 'node:fs'; rmSync('dist/mockServiceWorker.js', { force: true });\"",
		"dev": "sh -c 'pnpm run prebuild && rslib build --no-dts --no-clean && bun scripts/generate-distribution-css.ts && rslib build --watch --no-dts --no-clean'",
		"fmt": "oxfmt -c ../../../oxfmt.sdk.config.ts .",
		"lint": "oxlint -c ../../../oxlint.sdk.config.ts ./src",
		"prebuild": "genversion --esm --semi src/version.ts",
		"prepack": "pnpm run build:docs && bun ../../../scripts/verify-package-artifacts.ts",
		"test": "pnpm run prebuild && vitest run",
		"test:watch": "pnpm run prebuild && vitest"
	},
	"dependencies": {
		"@inth/sdk": "workspace:*",
		"@types/google.maps": "3.65.3"
	},
	"devDependencies": {
		"@inth/conformance": "workspace:*",
		"@inth/typescript-config": "workspace:*",
		"@inth/vitest-config": "workspace:*",
		"@iabtechlabtcf/core": "^1.5.22",
		"@rsbuild/plugin-react": "1.4.6",
		"@rslib/core": "0.23.2",
		"@types/node": "25.5.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/browser": "4.1.10",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-istanbul": "4.1.10",
		"genversion": "3.2.0",
		"jsdom": "25.0.1",
		"msw": "^2.14.6",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"typescript": "7.0.2",
		"vite": "8.1.3",
		"vitest": "4.1.10",
		"vitest-browser-react": "2.2.0"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0 || ^19.0.0-rc",
		"react-dom": "^18.0.0 || ^19.0.0 || ^19.0.0-rc"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
	],
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
