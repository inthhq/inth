		"./components/consent-gate": {
			"types": "./dist-types/components/consent-gate/index.d.ts",
			"import": "./dist/components/consent-gate/index.js",
			"default": "./dist/components/consent-gate/index.js"
		},
		"./components/frame": {
			"types": "./dist-types/components/consent-gate/index.d.ts",
