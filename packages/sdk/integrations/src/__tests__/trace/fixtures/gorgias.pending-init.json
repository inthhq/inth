{
	"name": "gorgias.pending-init",
	"scenarios": {
		"an old init promise settles after revoke and regrant": [
			{ "step": "start granted" },
			{
				"insert": "script",
				"in": "body",
				"attrs": {
					"id": "inth-#1",
					"nonce": "trace-nonce",
					"src": "https://config.gorgias.chat/bundle-loader/app-key"
				},
				"async": true
			},
			{ "step": "load" },
			{ "load": "https://config.gorgias.chat/bundle-loader/app-key" },
			{ "call": "GorgiasChat#1.init", "args": [] },
			{
				"global": "GorgiasChat",
				"value": {
					"disableSegment": "[stub GorgiasChat#1.disableSegment]",
					"init": "[stub GorgiasChat#1.init]"
				}
			},
			{ "step": "deny" },
			{
				"remove": "[<script> #inth-#1 https://config.gorgias.chat/bundle-loader/app-key]"
			},
			{ "step": "grant" },
			{
				"insert": "script",
				"in": "body",
				"attrs": {
					"id": "inth-#1",
					"nonce": "trace-nonce",
					"src": "https://config.gorgias.chat/bundle-loader/app-key"
				},
				"async": true
			},
			{ "step": "load" },
			{ "load": "https://config.gorgias.chat/bundle-loader/app-key" },
			{ "call": "GorgiasChat#2.init", "args": [] },
			{
				"global": "GorgiasChat",
				"value": {
					"disableSegment": "[stub GorgiasChat#2.disableSegment]",
					"init": "[stub GorgiasChat#2.init]"
				}
			},
			{ "step": "init #1 resolves" },
			{ "step": "init #2 resolves" },
			{ "call": "GorgiasChat#2.disableSegment", "args": [] },
			{ "step": "dispose" },
			{
				"remove": "[<script> #inth-#1 https://config.gorgias.chat/bundle-loader/app-key]"
			}
		],
		"revoke while init is pending": [
			{ "step": "start granted" },
			{
				"insert": "script",
				"in": "body",
				"attrs": {
					"id": "inth-#1",
					"nonce": "trace-nonce",
					"src": "https://config.gorgias.chat/bundle-loader/app-key"
				},
				"async": true
			},
			{ "step": "load" },
			{ "load": "https://config.gorgias.chat/bundle-loader/app-key" },
			{ "call": "GorgiasChat#1.init", "args": [] },
			{
				"global": "GorgiasChat",
				"value": {
					"disableSegment": "[stub GorgiasChat#1.disableSegment]",
					"init": "[stub GorgiasChat#1.init]"
				}
			},
			{ "step": "deny" },
			{
				"remove": "[<script> #inth-#1 https://config.gorgias.chat/bundle-loader/app-key]"
			},
			{ "step": "init #1 resolves" },
			{ "step": "dispose" }
		]
	}
}
