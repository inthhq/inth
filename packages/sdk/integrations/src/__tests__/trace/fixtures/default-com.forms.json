		"denied, grant, load, revoke, regrant, dispose": [
			{ "step": "start denied" },
			{ "step": "grant" },
			{
				"insert": "script",
				"in": "head",
				"attrs": {
					"id": "inth-#1",
					"nonce": "trace-nonce",
					"src": "https://handshake.default.com/sdk.js"
				},
				"async": true
			},
			{ "step": "load" },
			{ "load": "https://handshake.default.com/sdk.js" },
			{
				"call": "DefaultPixelSDK.setConsent",
				"args": [{ "analytics": false, "marketing": false }]
			},
			{
				"call": "DefaultPixelSDK.init",
				"args": [
					{
						"autoDisplayScheduler": false,
						"publicKey": "public-key",
						"schedulerOrigins": "[undefined]"
					}
				]
			},
			{
				"global": "DefaultPixelSDK",
				"value": {
					"init": "[stub DefaultPixelSDK.init]",
					"on": "[stub DefaultPixelSDK.on]",
					"recordFormInteraction": "[stub DefaultPixelSDK.recordFormInteraction]",
					"scheduler": {
						"display": "[stub DefaultPixelSDK.scheduler.display]"
					},
