{
	"name": "salesforce-pardot.classic",
	"scenarios": {
		"denied, grant, load, revoke, regrant, dispose": [
			{ "step": "start denied" },
			{ "step": "grant" },
			{
				"insert": "script",
				"in": "head",
				"attrs": {
					"id": "inth-#1",
					"nonce": "trace-nonce",
					"src": "https://pi.pardot.com/pd.js"
				},
				"async": true
			},
			{ "global": "piAId", "value": 123456 },
			{ "global": "piCId", "value": 654321 },
			{ "global": "piHostname", "value": "pi.pardot.com" },
			{ "step": "load" },
			{ "load": "https://pi.pardot.com/pd.js" },
			{ "step": "deny" },
			{ "remove": "[<script> #inth-#1 https://pi.pardot.com/pd.js]" },
			{ "step": "grant" },
			{
				"insert": "script",
