{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"entry": [
		"./src/index.ts",
		"./src/protocol/bridge-schema.ts",
		"./src/testing/index.ts",
		"./src/specs/NativeInth.ts"
	],
	"ignoreBinaries": ["oxfmt", "oxlint", "rslib", "tsc", "tsx", "vitest"],
	"ignore": [
		"**/*.spec.{js,ts,tsx}",
		"**/*.test.{js,ts,tsx}",
		"**/__tests__/**",
		"react-native.config.js",
		"rslib.config.ts",
		"scripts/**"
	],
	"ignoreDependencies": [
		"@babel/core",
		"@inth/sdk",
		"@inth/typescript-config",
		"@inth/vitest-config",
		"@react-native/codegen",
		"metro-transform-plugins"
	],
	"rules": {
		"exports": "warn",
		"types": "warn",
		"dependencies": "error",
		"files": "warn"
	},
	"ignoreExportsUsedInFile": true
}
