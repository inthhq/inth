{
	"name": "@c15t/react-native",
	"version": "3.0.0-alpha.2",
	"private": true,
	"description": "React Native consent management SDK with a native consent kernel for iOS and Android: banner, preference center, and consent-gated loading.",
	"keywords": [
		"android",
		"c15t",
		"ccpa",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management",
		"consent-management-platform",
		"cookie-consent",
		"expo",
		"gdpr",
		"headless",
		"ios",
		"mobile",
		"privacy",
		"react-native",
		"typescript"
	],
	"homepage": "https://c15t.com/",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/react-native"
	},
	"files": [
		"dist",
		"dist-types",
		"src/specs",
		"!src/specs/__tests__",
		"C15tReactNative.podspec",
		"app.plugin.js",
		"LICENSE.md",
		"NOTICE",
		"react-native.config.js",
		"android/c15t-react-native/build.gradle.kts",
		"android/c15t-react-native/consumer-rules.pro",
		"android/c15t-react-native/library.gradle",
		"android/c15t-react-native/src/main",
		"android/c15t-react-native/src/nativeUi",
		"android/c15t-react-native/src/withoutNativeUi",
		"android/codegen/generate-spec.mjs",
		"ios/C15tReactNative",
		"vendor/C15tCore",
		"vendor/C15tApple",
		"vendor/C15tConsentUI",
		"maestro",
		"AGENTS.md",
		"SKILL.md",
		"docs",
		"skills"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"react-native": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"react-native": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./bridge-schema": {
			"types": "./dist-types/protocol/bridge-schema.d.ts",
			"react-native": "./dist/protocol/bridge-schema.js",
			"import": "./dist/protocol/bridge-schema.js",
			"default": "./dist/protocol/bridge-schema.js"
		},
		"./integrations": {
			"types": "./dist-types/integrations/index.d.ts",
			"react-native": "./dist/integrations/index.js",
			"import": "./dist/integrations/index.js",
			"default": "./dist/integrations/index.js"
		},
		"./testing": {
			"types": "./dist-types/testing/index.d.ts",
			"react-native": "./dist/testing/index.js",
			"import": "./dist/testing/index.js",
			"default": "./dist/testing/index.js"
		},
		"./expo-plugin": {
			"types": "./dist-types/expo-plugin/index.d.ts",
			"require": "./dist/expo-plugin/index.cjs",
			"import": "./dist/expo-plugin/index.js",
			"default": "./dist/expo-plugin/index.js"
		},
		"./app.plugin.js": "./app.plugin.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rslib build && node ../../scripts/normalize-dist-types.mjs",
		"build:docs": "bun ../../scripts/generate-package-docs.ts @c15t/react-native",
		"check-types": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
		"dev": "sh -c 'rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "oxfmt -c ../../oxfmt.sdk.config.ts .",
		"generate:bridge-schema": "tsx scripts/generate-bridge-schema.ts",
		"generate:fixtures": "tsx scripts/generate-protocol-fixtures.ts",
		"lint": "oxlint -c ../../oxlint.sdk.config.ts ./src",
		"prepack": "pnpm run build:docs && bun -e \"await Bun.write('LICENSE.md', Bun.file('../../LICENSE')); await Bun.write('NOTICE', Bun.file('../../NOTICE'));\" && bun ../../scripts/sync-vendored-core.ts && bun ../../scripts/sync-vendored-apple.ts && bun ../../scripts/verify-package-artifacts.ts",
		"test": "vitest run --passWithNoTests",
		"test:coverage": "C15T_COVERAGE_RATCHET=1 vitest run --passWithNoTests && bun scripts/check-coverage-ratchet.ts",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/parser": "7.28.5",
		"@c15t/core": "workspace:*",
		"@c15t/iab": "workspace:*",
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@iabtechlabtcf/core": "1.5.22",
		"@react-native/codegen": "0.87.1",
		"@rsbuild/plugin-react": "1.4.6",
		"@rslib/core": "0.23.2",
		"@types/bun": "1.3.9",
		"@types/node": "25.5.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitest/coverage-istanbul": "4.1.10",
		"expo": "58.0.24",
		"jsdom": "25.0.1",
		"metro-transform-plugins": "0.84.5",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-native": "0.87.1",
		"tsx": "4.23.0",
		"typescript": "7.0.2",
		"vite": "8.1.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@c15t/core": "workspace:^",
		"expo": ">=55.0.0 <59.0.0",
		"react": ">=19.2.0 <19.4.0",
		"react-native": ">=0.83.0 <0.89.0"
	},
	"peerDependenciesMeta": {
		"@c15t/core": {
			"optional": true
		},
		"expo": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"codegenConfig": {
		"name": "C15tSpec",
		"type": "modules",
		"jsSrcsDir": "src/specs",
		"android": {
			"javaPackageName": "com.c15t.reactnative"
		},
		"ios": {
			"modules": {
				"C15t": {
					"className": "C15tReactNativeModule"
				}
			}
		}
	}
}
