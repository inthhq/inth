{
	"name": "@inth/benchmarks",
	"private": true,
	"type": "module",
	"scripts": {
		"bench": "BENCH_OUTPUT_DIR=../.benchmarks/current/micro node --import vite-plus/register micro/*.bench.ts",
		"bench:ci": "BENCH_OUTPUT_DIR=../.benchmarks/head/micro node --import vite-plus/register micro/*.bench.ts",
		"bench:has": "BENCH_OUTPUT_DIR=../.benchmarks/current/micro node --import vite-plus/register micro/has-condition.bench.ts",
		"bench:nightly": "BENCH_OUTPUT_DIR=../.benchmarks/nightly/micro node --import vite-plus/register micro/*.bench.ts",
		"bench:script-loader": "BENCH_OUTPUT_DIR=../.benchmarks/current/micro node --import vite-plus/register micro/script-loader.bench.ts",
		"bench:store": "BENCH_OUTPUT_DIR=../.benchmarks/current/micro node --import vite-plus/register micro/store.bench.ts",
		"bench:translations": "BENCH_OUTPUT_DIR=../.benchmarks/current/micro node --import vite-plus/register micro/translations.bench.ts"
	},
	"dependencies": {
		"@inth/benchmarking": "workspace:*",
		"@inth/react": "workspace:*",
		"@inth/sdk": "workspace:*",
		"mitata": "^1.0.34"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"@types/react": "19.2.17",
		"playwright": "catalog:",
		"react": "19.2.7",
		"tsx": "4.23.0",
		"typescript": "6.0.3"
	}
}
