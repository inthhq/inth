{
	"name": "@inth/mobile-bench",
	"private": true,
	"description": "Measured numbers for the mobile budgets in packages/native-protocol/CONTRACT.md: native cores, React rerenders, idle cost, and shipped bytes.",
	"type": "module",
	"scripts": {
		"bench": "vpx src/run.ts",
		"bench:ci": "vpx src/run.ts --check",
		"bench:quick": "vpx src/run.ts --quick",
		"build": "echo 'mobile benchmarks are source-only'",
		"check-types": "tsrs --noEmit",
		"competitive": "python3 competitive/harness.py",
		"competitive:build": "python3 competitive/harness.py build",
		"competitive:cached-runtime": "python3 competitive/cached-runtime/runner.py",
		"competitive:cached-runtime:test": "python3 competitive/cached-runtime/tests.py",
		"competitive:collect": "python3 competitive/harness.py collect",
		"competitive:plan": "python3 competitive/harness.py plan",
		"competitive:preflight": "python3 competitive/harness.py preflight",
		"competitive:prepare": "python3 competitive/harness.py prepare",
		"competitive:report": "python3 competitive/harness.py report",
		"competitive:runtime": "python3 competitive/harness.py runtime",
		"competitive:test": "python3 competitive/tests.py",
		"competitive:verify": "python3 competitive/harness.py verify",
		"fmt": "vp fmt -c ../../oxfmt.sdk.config.ts .",
		"lint": "vp lint -c ../../oxlint.sdk.config.ts ./src",
		"test": "vp test run"
	},
	"dependencies": {
		"@inth/benchmarking": "workspace:*",
		"@inth/react-native": "workspace:*",
		"@inth/sdk": "workspace:*",
		"react": "19.2.7"
	},
	"devDependencies": {
		"@inth/typescript-config": "workspace:*",
		"@types/bun": "1.3.9",
		"@types/node": "^24.10.1",
		"@types/react": "19.2.17",
		"@vitest/coverage-istanbul": "catalog:",
		"jsdom": "25.0.1",
		"react-test-renderer": "19.2.8",
		"tsrs": "catalog:",
		"tsx": "4.23.0",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
