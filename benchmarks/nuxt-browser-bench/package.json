{
	"name": "@c15t/nuxt-browser-bench",
	"private": true,
	"type": "module",
	"scripts": {
		"bench": "BENCH_OUTPUT_DIR=../../.benchmarks/current/browser-runtime/nuxt tsx scripts/run-bench.ts",
		"bench:bundle": "pnpm run build && tsx scripts/analyze-bundle.ts",
		"bench:ci": "BENCH_OUTPUT_DIR=../../.benchmarks/head/browser-runtime/nuxt tsx scripts/run-bench.ts",
		"bench:gate": "BENCH_OUTPUT_DIR=../../.benchmarks/head/consent-gate tsx scripts/run-gate.ts",
		"bench:nightly": "BENCH_OUTPUT_DIR=../../.benchmarks/nightly/browser-runtime/nuxt tsx scripts/run-bench.ts",
		"build": "C15T_ON_BUILD_ERROR=runtime nuxt build",
		"dev": "nuxt dev",
		"start": "node .output/server/index.mjs"
	},
	"dependencies": {
		"@c15t/benchmarking": "workspace:*",
		"@c15t/core": "workspace:*",
		"@c15t/vue": "workspace:*",
		"nuxt": "4.6.0",
		"vue": "3.5.43"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"playwright": "1.58.2",
		"tsx": "4.23.0",
		"typescript": "6.0.3"
	}
}
