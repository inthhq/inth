{
	"name": "@inth/tanstack-start-browser-bench",
	"private": true,
	"type": "module",
	"scripts": {
		"bench": "BENCH_OUTPUT_DIR=../../.benchmarks/current/browser-runtime/tanstack-start tsx scripts/run-bench.ts",
		"bench:ci": "BENCH_OUTPUT_DIR=../../.benchmarks/head/browser-runtime/tanstack-start tsx scripts/run-bench.ts",
		"bench:gate": "BENCH_OUTPUT_DIR=../../.benchmarks/head/consent-gate tsx scripts/run-gate.ts",
		"bench:nightly": "BENCH_OUTPUT_DIR=../../.benchmarks/nightly/browser-runtime/tanstack-start tsx scripts/run-bench.ts",
		"build": "vite build",
		"build:root": "INTH_BENCH_ROOT_PROVIDER=1 vite build --outDir dist-root",
		"dev": "vite dev --port 4314",
		"start": "node scripts/serve.mjs"
	},
	"dependencies": {
		"@inth/benchmarking": "workspace:*",
		"@inth/react": "workspace:*",
		"@inth/sdk": "workspace:*",
		"@inth/tanstack-start": "workspace:*",
		"@tanstack/react-router": "1.170.44",
		"@tanstack/react-start": "1.169.1",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@rsbuild/core": "1.7.5",
		"@types/node": "22.19.11",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.3",
		"playwright": "1.61.1",
		"srvx": "0.12.4",
		"tsx": "4.23.0",
		"typescript": "7.0.2",
		"vite": "8.1.3"
	}
}
