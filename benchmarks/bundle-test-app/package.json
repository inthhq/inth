{
  "name": "@inth/next-bundle-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "analyze:json": "vpx analyze-bundle.ts --json",
    "analyze:md": "vpx analyze-bundle.ts --markdown",
    "bench": "BENCH_OUTPUT_DIR=../../.benchmarks/current/bundle vpx analyze-bundle.ts && BENCH_OUTPUT_DIR=../../.benchmarks/current/bundle vpx analyze-entries.ts",
    "bench:ci": "BENCH_OUTPUT_DIR=../../.benchmarks/head/bundle vpx analyze-bundle.ts && BENCH_OUTPUT_DIR=../../.benchmarks/head/bundle vpx analyze-entries.ts",
    "bench:entries": "vpx analyze-entries.ts",
    "bench:nightly": "BENCH_OUTPUT_DIR=../../.benchmarks/nightly/bundle vpx analyze-bundle.ts && BENCH_OUTPUT_DIR=../../.benchmarks/nightly/bundle vpx analyze-entries.ts",
    "build": "next build",
    "dev": "next dev",
    "test": "vp test run"
  },
  "dependencies": {
    "@inth/benchmarking": "workspace:*",
    "@inth/nextjs": "workspace:*",
    "@inth/react": "workspace:*",
    "@inth/sdk": "workspace:*",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.10",
    "@types/bun": "1.3.9",
    "@types/node": "25.5.0",
    "@types/react": "19.2.17",
    "@vitest/coverage-istanbul": "catalog:",
    "esbuild": "^0.28.1",
    "jsdom": "25.0.1",
    "playwright": "catalog:",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
