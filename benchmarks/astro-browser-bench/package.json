{
	"name": "@inth/astro-browser-bench",
	"private": true,
	"type": "module",
	"scripts": {
		"bench": "BENCH_OUTPUT_DIR=../../.benchmarks/current/browser-runtime/astro tsx scripts/run-bench.ts",
		"bench:bundle": "pnpm run build && tsx scripts/analyze-bundle.ts",
		"bench:ci": "BENCH_OUTPUT_DIR=../../.benchmarks/head/browser-runtime/astro tsx scripts/run-bench.ts",
		"bench:gate": "BENCH_OUTPUT_DIR=../../.benchmarks/head/consent-gate tsx scripts/run-gate.ts",
		"bench:nightly": "BENCH_OUTPUT_DIR=../../.benchmarks/nightly/browser-runtime/astro tsx scripts/run-bench.ts",
		"build": "astro build",
		"check-types": "astro check",
		"dev": "astro dev",
		"start": "node dist/server/entry.mjs"
	},
	"dependencies": {
		"@astrojs/node": "^9.5.0",
		"@astrojs/svelte": "^7.2.0",
		"@inth/astro": "workspace:*",
		"@inth/benchmarking": "workspace:*",
		"@inth/sdk": "workspace:*",
		"@inth/svelte": "workspace:*",
		"astro": "^5.16.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@types/node": "25.5.0",
		"playwright": "1.58.2",
		"tsx": "4.23.0",
		"typescript": "6.0.3"
	}
}
