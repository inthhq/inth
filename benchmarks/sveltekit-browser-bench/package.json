{
  "name": "@inth/sveltekit-browser-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "BENCH_OUTPUT_DIR=../../.benchmarks/current/browser-runtime/sveltekit vpx scripts/run-bench.ts",
    "bench:bundle": "pnpm run build && vpx scripts/analyze-bundle.ts",
    "bench:ci": "BENCH_OUTPUT_DIR=../../.benchmarks/head/browser-runtime/sveltekit vpx scripts/run-bench.ts",
    "bench:gate": "BENCH_OUTPUT_DIR=../../.benchmarks/head/consent-gate vpx scripts/run-gate.ts",
    "bench:nightly": "BENCH_OUTPUT_DIR=../../.benchmarks/nightly/browser-runtime/sveltekit vpx scripts/run-bench.ts",
    "build": "vp build",
    "check-types": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "vp dev",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@inth/benchmarking": "workspace:*",
    "@inth/sdk": "workspace:*",
    "@inth/svelte": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "25.5.0",
    "playwright": "catalog:",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.5",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
