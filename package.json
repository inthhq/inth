{
  "name": "inth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test",
    "dev": "turbo run dev",
    "dev:link": "pnpm --filter @inth/cli dev:link",
    "dev:unlink": "pnpm --filter @inth/cli dev:unlink",
    "format": "ultracite fix .",
    "lint": "ultracite check .",
    "lint:fix": "ultracite fix .",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "tegami": "node packages/cli/scripts/tegami.ts",
    "typecheck": "turbo run typecheck",
    "docs:lint": "leadtype lint --error-unknown --max-warnings 0",
    "docs:bundle": "node packages/cli/scripts/generate-docs.ts",
    "docs:check": "pnpm docs:lint && pnpm docs:bundle && node packages/cli/scripts/verify-docs.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "leadtype": "0.4.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tegami": "1.3.4",
    "turbo": "2.10.12",
    "ultracite": "7.10.8",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0"
}
