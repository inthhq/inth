{
  "name": "inth",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=@inth/cli --filter='@inth/cli-*'",
    "check": "pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test",
    "dev": "turbo run dev --filter=@inth/cli --filter='@inth/cli-*'",
    "dev:link": "pnpm --filter @inth/cli dev:link",
    "dev:unlink": "pnpm --filter @inth/cli dev:unlink",
    "format": "ultracite fix . --disable-nested-config",
    "lint": "ultracite check . --disable-nested-config",
    "lint:fix": "ultracite fix . --disable-nested-config",
    "test": "turbo run test --filter=@inth/cli --filter='@inth/cli-*'",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "tegami": "node packages/cli/scripts/tegami.ts",
    "typecheck": "turbo run typecheck --filter=@inth/cli --filter='@inth/cli-*'",
    "docs:lint": "leadtype lint --error-unknown --max-warnings 0",
    "docs:bundle": "node packages/cli/scripts/generate-docs.ts",
    "docs:check": "pnpm docs:lint && pnpm docs:bundle && node packages/cli/scripts/verify-docs.ts",
    "sdk:build": "turbo run build build:docs --filter='./packages/sdk/*' --filter=./packages/react-native",
    "sdk:build:all": "pnpm sdk:turbo:all build build:docs",
    "sdk:check-types": "pnpm sdk:turbo:all check-types",
    "sdk:dev": "turbo run dev --filter=@inth/playground",
    "sdk:fmt": "pnpm --dir scripts run fmt:repo",
    "sdk:fmt:check": "pnpm --dir scripts run fmt:check",
    "sdk:lint": "pnpm sdk:turbo:all lint && pnpm sdk:lint:repo && pnpm --dir scripts run lint:testids",
    "sdk:test": "turbo run test --filter='./packages/sdk/*' --filter=./packages/react-native",
    "sdk:test:all": "pnpm sdk:turbo:all test",
    "sdk:turbo:all": "turbo run --filter='./packages/sdk/*' --filter=./packages/react-native --filter='./apps/*' --filter='./benchmarks/**' --filter='./internals/**' --filter='./examples/*' --filter=./scripts",
    "sdk:turbo:bench": "turbo run --filter=@inth/core-benchmarks --filter=@inth/next-bundle-bench --filter=@inth/react-browser-bench --filter=@inth/nextjs-browser-bench --filter=@inth/nuxt-browser-bench --filter=@inth/tanstack-start-browser-bench --filter=@inth/script-lifecycle-bench --filter=@inth/sveltekit-browser-bench --filter=@inth/astro-browser-bench",
    "sdk:test:scripts": "pnpm --dir scripts run test:scripts",
    "sdk:test:parity": "turbo run test:parity --filter=@inth/parity-runner",
    "sdk:test:storybook": "turbo run test-storybook --filter=@inth/storybook-react --filter=@inth/storybook-svelte --filter=@inth/storybook-vue --filter=@inth/storybook-angular",
    "sdk:bench": "pnpm sdk:turbo:bench bench",
    "sdk:bench:ci": "pnpm sdk:turbo:bench bench:ci",
    "sdk:bench:nightly": "pnpm sdk:turbo:bench bench:nightly",
    "sdk:bench:micro": "turbo run bench --filter=@inth/benchmarks",
    "sdk:compat:styles:build": "turbo run build --filter=@inth/css-layer-preview --filter=@inth/tw3-css-test --filter=@inth/tw4-css-test --filter=@inth/no-tw-css-test --filter=@inth/tailwind-matrix-v3 --filter=@inth/tailwind-matrix-v4",
    "sdk:lint:repo": "pnpm --dir scripts run lint:repo",
    "sdk:pack": "node tools/ci/sdk-pack.ts",
    "tegami:sdk": "node tools/ci/sdk-release.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "leadtype": "0.4.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tegami": "1.3.4",
    "turbo": "2.10.12",
    "ultracite": "7.10.8",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0"
}
